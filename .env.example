# GoatFlow Environment Configuration Example
# Copy this file to .env and update with your values
#
# SECURITY WARNING: 
# - NEVER commit .env files to version control
# - ALWAYS change all default passwords before deployment
# - Use strong, unique passwords for production
# - Store production secrets in a secure vault (e.g., HashiCorp Vault, AWS Secrets Manager)

# ============================================
# Application
# ============================================

# Go version for container builds (single source of truth)
GO_IMAGE=golang:1.25.12-alpine

APP_ENV=development
APP_PORT=8080
# Public URL of the agent UI. docker-compose.yml passes it to the backend as
# BASE_URL; password-reset and sign-up email links are built from it.
APP_URL=http://localhost:8081

# JWT signing secret. Production refuses to start with this placeholder or with
# anything shorter than 32 characters: `openssl rand -hex 32`.
JWT_SECRET=CHANGE_THIS_SECRET_KEY_BEFORE_USE
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Encryption key for stored secrets (plugin secure config, connector
# credentials): exactly 64 hex characters, `openssl rand -hex 32`. Required by
# docker-compose.yml. Backend, customer-fe and runner must share it. Keep it:
# changing it makes every value encrypted with the old key unreadable.
# `make synthesize` generates both secrets.
GOATFLOW_SECURE_KEY=

# ============================================
# Password Hashing
# ============================================
# PASSWORD_HASH_TYPE: algorithm for every new agent and customer password.
#   bcrypt (default, recommended). Existing OTRS sha2 (unsalted SHA-256)
#   hashes, e.g. from an OTRS/Znuny import, still log in whatever this is set to.
#   sha256 only when running side by side with an OTRS that must read the same
#   users/customer_user tables; it is unsalted and much weaker.
# MIGRATE_PASSWORD_HASHES=true rehashes a password stored in another format
#   into PASSWORD_HASH_TYPE on that user's next successful login (agents and
#   customers). false leaves stored hashes untouched.
PASSWORD_HASH_TYPE=bcrypt
MIGRATE_PASSWORD_HASHES=false

# ============================================
# Database
# ============================================

DB_DRIVER=mariadb
DB_MYSQL_HOST=mariadb
DB_MYSQL_PORT=3306
DB_MYSQL_NAME=otrs
DB_MYSQL_USER=otrs
DB_MYSQL_PASSWORD=ChangeThisPassword123!
DB_PGSQL_HOST=postgres
DB_PGSQL_PORT=5432
DB_PGSQL_NAME=goatflow
DB_PGSQL_USER=goatflow
DB_PGSQL_PASSWORD=ChangeThisPassword123!
DB_PGSQL_SSLMODE=disable
DB_SCOPE=primary
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword123!

DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=30m

# Database URL (alternative to individual settings)
# DATABASE_URL=mysql://otrs:ChangeThisPassword123!@mariadb:3306/otrs?parseTime=true&tls=false

# ============================================
# GoatFlow Admin User
# REQUIRED: Initial admin password for db-init targets
# ============================================

GOATFLOW_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ============================================
# Test Databases & Cache
# REQUIRED: These must be set for tests to run
# ============================================

TEST_DB_DRIVER=mysql
TEST_DB_NAME=goatflow_test
TEST_DB_USER=goatflow_user
TEST_DB_PASSWORD=CHANGE_THIS_TEST_PASSWORD

# Postgres test database (toolbox targets)
TEST_DB_POSTGRES_HOST=postgres-test
TEST_DB_POSTGRES_PORT=5433
TEST_DB_POSTGRES_NAME=goatflow_test
TEST_DB_POSTGRES_USER=goatflow_user
TEST_DB_POSTGRES_PASSWORD=CHANGE_THIS_TEST_PASSWORD

# MariaDB test database (compose test profile)
TEST_DB_MYSQL_HOST=mariadb-test
TEST_DB_MYSQL_PORT=3308
TEST_DB_MYSQL_NAME=otrs_test
TEST_DB_MYSQL_USER=otrs
TEST_DB_MYSQL_PASSWORD=CHANGE_THIS_TEST_PASSWORD
TEST_DB_MYSQL_CONTAINER_PORT=3306
TEST_DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

# Postgres test database container internal port
TEST_DB_POSTGRES_CONTAINER_PORT=5432

# Test database SSL mode
TEST_DB_SSLMODE=disable

# Toolbox host-network test overrides
TOOLBOX_TEST_DB_HOST=127.0.0.1
TOOLBOX_TEST_DB_PORT=3308

# Tell tests the DB is ready (for CI/container environments)
GOATFLOW_TEST_DB_READY=1

# Test backend config
TEST_BACKEND_SERVICE_HOST=backend-test
TEST_BACKEND_CONTAINER_PORT=8080
TEST_BACKEND_BASE_URL=http://localhost:8082

# Test cache settings
TEST_DB_REDIS_HOST=valkey-test
TEST_REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ============================================
# Valkey Cache
# ============================================

VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# Redis compatibility aliases
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Valkey URL (alternative to individual settings)
# VALKEY_URL=valkey://valkey:6379/0

VALKEY_TEST_HOST=valkey-test
VALKEY_TEST_PORT=6379

# ============================================
# Email Configuration
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@goatflow.io
SMTP_FROM_NAME=GoatFlow Support
SMTP_TLS=true
SMTP_SKIP_VERIFY=true
EMAIL_FROM=noreply@goatflow.io
EMAIL_ENABLED=true

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_SSL=true
IMAP_FOLDER=INBOX

EMAIL_FETCH_INTERVAL=5m
EMAIL_MAX_SIZE=10MB

# ============================================
# Storage
# ============================================

# Article attachments: db (in the database, default) or fs (OTRS ArticleStorageFS
# layout under $STORAGE_PATH/var/article). Switch with cmd/goatflow-storage.
STORAGE_TYPE=db
STORAGE_PATH=/app/storage

MAX_UPLOAD_SIZE=10MB
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,png,jpg,jpeg,gif,zip

# ============================================
# Security
# ============================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

SESSION_SECRET=your-session-secret-here
SESSION_MAX_AGE=86400
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# ============================================
# Logging
# ============================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=./logs/goatflow.log

# ============================================
# Monitoring
# ============================================

METRICS_ENABLED=true
METRICS_PORT=9090
# How long to wait for in-flight HTTP requests (server) or cancelled tasks
# (runner) on SIGTERM. Positive Go duration; invalid values log an error and
# the default 5s is used. Keep the container stop grace period >= this + 40s.
DRAIN_TIMEOUT=5s
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=goatflow

# ============================================
# Demo Mode / Testing Credentials
# REQUIRED: These must be set for E2E tests to run
# ============================================

DEMO_MODE=false
DEMO_RESET_SCHEDULE="0 2 * * *"
DEMO_DATA_FILE=./demo-data/sample.json

DEMO_ADMIN_EMAIL=demo-admin@example.com
DEMO_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
DEMO_AGENT_EMAIL=demo-agent@example.com
DEMO_AGENT_PASSWORD=CHANGE_THIS_AGENT_PASSWORD
DEMO_CUSTOMER_EMAIL=demo-customer@example.com
DEMO_CUSTOMER_PASSWORD=CHANGE_THIS_CUSTOMER_PASSWORD

# ============================================
# Feature Flags
# ============================================

FEATURE_AI_SUGGESTIONS=false
FEATURE_ADVANCED_WORKFLOWS=false
FEATURE_MULTI_LANGUAGE=false
FEATURE_WEBHOOKS=true
FEATURE_API_V2=false

# ============================================
# Search backend (docs/ZINC_SEARCH.md)
# ============================================

# database (default), zinc or elasticsearch. Backend and runner need the same values.
SEARCH_BACKEND=
# SEARCH_INDEX_PREFIX=goatflow_

# Zinc (`docker compose --profile search up -d zinc`); the user/password also
# create Zinc's first admin
ZINC_ENDPOINT=http://zinc:4080
ZINC_USER=zinc_admin
ZINC_PASSWORD=ChangeThisZincPassword123!

# Elasticsearch
# ELASTICSEARCH_ENDPOINT=http://elasticsearch:9200
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# ============================================
# LDAP/Active Directory agent login (see docs/LDAP.md for every setting)
# ============================================
# Disabled by default. To enable, set LDAP_ENABLED=true AND put ldap in the
# provider order, e.g. AUTH_PROVIDERS=ldap,database. Invalid LDAP_* values
# stop GoatFlow at startup with an error naming the variable.

# AUTH_PROVIDERS=ldap,database
LDAP_ENABLED=false
# LDAP_TYPE: openldap | 389ds | active_directory (fills filter/attribute defaults)
# LDAP_TYPE=openldap
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# StartTLS (LDAP_USE_TLS) or LDAPS (LDAP_USE_SSL, port 636); certificates are verified
# LDAP_USE_TLS=true
# LDAP_USE_SSL=false
# LDAP_TLS_CA_FILE=/etc/goatflow/ldap-ca.pem
# LDAP_SKIP_TLS_VERIFY=false
# LDAP_TIMEOUT=10
# LDAP_BIND_DN=cn=goatflow,ou=system,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_BASE_DN=ou=people,dc=example,dc=com
# LDAP_USER_FILTER=(&(objectClass=inetOrgPerson)(uid=%s))
# LDAP_IS_ACTIVE_DIRECTORY=false
# LDAP_DOMAIN=
# LDAP_USERNAME_ATTRIBUTE=uid
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_FIRST_NAME_ATTRIBUTE=givenName
# LDAP_LAST_NAME_ATTRIBUTE=sn
# LDAP_DISPLAY_NAME_ATTRIBUTE=cn
# LDAP_GROUP_BASE_DN=ou=groups,dc=example,dc=com
# LDAP_GROUP_FILTER=(&(objectClass=groupOfNames)(member=%s))
# LDAP_GROUP_MEMBER_VALUE=dn
# LDAP_GROUP_ATTRIBUTE=cn
# Only members of LDAP_AGENT_GROUPS (or LDAP_ADMIN_GROUPS) may log in; GoatFlow
# admin group membership follows LDAP_ADMIN_GROUPS.
# LDAP_AGENT_GROUPS=helpdesk
# LDAP_ADMIN_GROUPS=goatflow-admins
# LDAP_AUTO_CREATE_USERS=false
# LDAP_AUTO_UPDATE_USERS=false
# LDAP_INITIAL_GROUPS=users

# ============================================
# External Services
# ============================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ============================================
# Development
# ============================================

DEV_HOT_RELOAD=true
DEV_VERBOSE_ERRORS=true
DEV_SQL_DEBUG=false

VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# ============================================
# Admin Credentials
# ============================================

ADMIN_USER=root@localhost
ADMIN_PASSWORD=ChangeThisPassword123!

TEST_PG_ADMIN_USER=root@localhost
TEST_PG_ADMIN_PASSWORD=ChangeThisPassword123!
TEST_MYSQL_ADMIN_USER=root@localhost
TEST_MYSQL_ADMIN_PASSWORD=ChangeThisPassword123!

# ============================================
# Testing Controls
# ============================================

GOATFLOW_DISABLE_TEST_AUTH_BYPASS=1
TEST_BACKEND_PORT=18081
BACKEND_TEST_PORT=8082

# ============================================
# Container Ports & IDs
# ============================================

HOST_UID=1000
HOST_GID=1000
BACKEND_PORT=8081
VALKEY_TEST_PORT=6389
SMTP4DEV_SMTP_PORT=1025
SMTP4DEV_IMAP_PORT=1143
SMTP4DEV_POP3_PORT=1110
SMTP4DEV_UI_PORT=8025
ADMINER_PORT=8090

# ============================================
# API Testing
# ============================================

TEST_USERNAME=root@localhost
TEST_PASSWORD=admin123
BACKEND_URL=https://goatflow-backend:8080

# Test environment
TEST_REDIS_PASSWORD=
SESSION_SECRET=generate-a-secure-secret-for-production
