const gkMFAApiBase = '{{ mfa_api_base|default:"/api/preferences/2fa"|escapejs }}';
const gkMFAI18n = {
    mfaEnabledLabel: '{{ t("settings.2fa.mfa_enabled_label")|default:"MFA enabled"|escapejs }}',
    authenticatorAppEnabledLabel: '{{ t("settings.2fa.authenticator_app_enabled_label")|default:"Authenticator app enabled"|escapejs }}',
    securityKeyEnabledLabel: '{{ t("settings.2fa.security_key_enabled_label")|default:"Security key enabled"|escapejs }}',
    mfaEnabledDescription: '{{ t("settings.2fa.mfa_enabled_description")|default:"Authenticator app codes and security keys are enabled for this account."|escapejs }}',
    authenticatorAppEnabledDescription: '{{ t("settings.2fa.authenticator_app_enabled_description")|default:"Authenticator app codes are required after password login."|escapejs }}',
    securityKeyEnabledDescription: '{{ t("settings.2fa.security_key_enabled_description")|default:"A security key is registered and will be required after password login."|escapejs }}',
    noFactorDescription: '{{ t("settings.2fa.no_factor_description")|default:"Add an authenticator app or security key to protect this account."|escapejs }}',
    enableAuthenticatorApp: '{{ t("settings.2fa.enable_authenticator_app")|default:"Enable authenticator app"|escapejs }}',
    enable2FA: '{{ t("settings.2fa.enable")|default:"Enable 2FA"|escapejs }}',
    securityKeyRegisteredSingular: '{{ t("settings.2fa.security_key_registered_singular")|default:"1 security key registered"|escapejs }}',
    securityKeyRegisteredCount: '{{ t("settings.2fa.security_key_registered_count")|default:"{count} security keys registered"|escapejs }}',
    passkeyAdded: '{{ t("settings.2fa.passkey_added")|default:"Added {date}"|escapejs }}',
    passkeyLastUsed: '{{ t("settings.2fa.passkey_last_used")|default:"Last used {date}"|escapejs }}',
    passkeyNeverUsed: '{{ t("settings.2fa.passkey_never_used")|default:"Never used"|escapejs }}',
    passkeySetUpOn: '{{ t("settings.2fa.passkey_set_up_on")|default:"Set up on {host}"|escapejs }}',
    passkeyOtherAddress: '{{ t("settings.2fa.passkey_other_address")|default:"Does not work on this address"|escapejs }}',
    passkeyRemove: '{{ t("settings.2fa.passkey_remove")|default:"Remove"|escapejs }}',
    passkeyRemoveTitle: '{{ t("settings.2fa.passkey_remove_title")|default:"Remove passkey"|escapejs }}',
    passkeyRemoveMessage: '{{ t("settings.2fa.passkey_remove_message")|default:"Enter your password to remove “{name}”."|escapejs }}',
    passkeyRemoveLastWarning: '{{ t("settings.2fa.passkey_remove_last_warning")|default:"This is your last passkey and you have no authenticator app, so two-factor authentication will be turned off and your recovery codes deleted."|escapejs }}',
    recoveryCodesNew: '{{ t("settings.2fa.recovery_codes_new")|default:"New recovery codes"|escapejs }}',
    recoveryCodesNewMessage: '{{ t("settings.2fa.recovery_codes_new_message")|default:"Enter your password to create a new set of recovery codes. Your old codes will stop working."|escapejs }}',
    passwordRequired: '{{ t("settings.2fa.password_required")|default:"Please enter your password"|escapejs }}',
    genericError: '{{ t("errors.generic")|default:"An error occurred. Please try again."|escapejs }}'
};

// Current factors, kept for the passkey-removal warning.
const gkMFAState = { hasTOTP: false, keyCount: 0 };
// The action the password-confirmation modal runs.
let gkMFAConfirmAction = null;

function gkMFAElement(id) {
    return document.getElementById(id);
}

function gkMFAShow(id, visible) {
    const el = gkMFAElement(id);
    if (!el) return;
    el.classList.toggle('hidden', !visible);
}

function gkMFASetText(id, value) {
    const el = gkMFAElement(id);
    if (!el) return;
    el.textContent = value;
}

async function gkMFARequest(path, options = {}) {
    const response = await fetch(gkMFAApiBase + path, {
        credentials: 'same-origin',
        ...options,
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
    });
    return response.json();
}

function renderMFAProfileStatus(data) {
    const hasTOTP = data.totp_enabled === true;
    const keyCount = Number(data.webauthn_credentials || 0);
    const hasSecurityKey = data.webauthn_enabled === true || keyCount > 0;
    const hasAnyFactor = hasTOTP || hasSecurityKey || data.enabled === true;
    gkMFAState.hasTOTP = hasTOTP;
    gkMFAState.keyCount = keyCount;

    gkMFAShow('2fa-status-loading', false);
    gkMFAShow('2fa-status-enabled', hasAnyFactor);
    gkMFAShow('2fa-status-disabled', !hasAnyFactor);
    gkMFAShow('2fa-setup-btn', !hasTOTP);
    gkMFAShow('2fa-disable-btn', hasAnyFactor);
    gkMFAShow('webauthn-add-btn', true);
    gkMFAShow('2fa-recovery-info', hasAnyFactor);
    gkMFAShow('mfa-recovery-new-btn', hasAnyFactor);
    gkMFAShow('webauthn-info', keyCount > 0);

    if (hasTOTP && hasSecurityKey) {
        gkMFASetText('2fa-status-enabled-label', gkMFAI18n.mfaEnabledLabel);
        gkMFASetText('2fa-description', gkMFAI18n.mfaEnabledDescription);
    } else if (hasTOTP) {
        gkMFASetText('2fa-status-enabled-label', gkMFAI18n.authenticatorAppEnabledLabel);
        gkMFASetText('2fa-description', gkMFAI18n.authenticatorAppEnabledDescription);
    } else if (hasSecurityKey) {
        gkMFASetText('2fa-status-enabled-label', gkMFAI18n.securityKeyEnabledLabel);
        gkMFASetText('2fa-description', gkMFAI18n.securityKeyEnabledDescription);
    } else {
        gkMFASetText('2fa-description', gkMFAI18n.noFactorDescription);
    }

    gkMFASetText('2fa-setup-btn', hasSecurityKey && !hasTOTP ? gkMFAI18n.enableAuthenticatorApp : gkMFAI18n.enable2FA);
    gkMFASetText('recovery-count', data.recovery_codes_remaining || 0);
    if (keyCount > 0) {
        const keyText = keyCount === 1
            ? gkMFAI18n.securityKeyRegisteredSingular
            : gkMFAI18n.securityKeyRegisteredCount.replace('{count}', keyCount);
        gkMFASetText('webauthn-info', keyText);
        gkMFALoadPasskeys();
    }
}

function renderMFAProfileStatusFallback() {
    gkMFAShow('2fa-status-loading', false);
    gkMFAShow('2fa-status-disabled', true);
    gkMFAShow('2fa-setup-btn', true);
    gkMFAShow('webauthn-add-btn', true);
    gkMFASetText('2fa-description', gkMFAI18n.noFactorDescription);
}

function gkMFAFormatDate(value) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleDateString(document.documentElement.lang || undefined, { day: 'numeric', month: 'short', year: 'numeric' });
}

async function gkMFALoadPasskeys() {
    const list = gkMFAElement('webauthn-list');
    if (!list) return;
    try {
        const data = await gkMFARequest('/webauthn/credentials');
        if (!data.success) return;
        list.replaceChildren(...data.credentials.map(gkMFAPasskeyRow));
        gkMFAShow('webauthn-list', data.credentials.length > 0);
    } catch (e) {
        console.error('Error loading passkeys:', e);
    }
}

// Builds one passkey row with textContent only: names are user input.
function gkMFAPasskeyRow(cred) {
    const row = document.createElement('li');
    row.className = 'flex flex-wrap items-center justify-between gap-3 py-2';
    row.style.borderTop = '1px solid var(--gk-border-default)';
    row.dataset.passkeyId = cred.id;

    const info = document.createElement('div');
    const name = document.createElement('div');
    name.className = 'text-sm font-medium';
    name.style.color = 'var(--gk-text-primary)';
    name.textContent = cred.name;
    info.appendChild(name);

    const facts = [gkMFAI18n.passkeyAdded.replace('{date}', gkMFAFormatDate(cred.created_at))];
    facts.push(cred.last_used_at
        ? gkMFAI18n.passkeyLastUsed.replace('{date}', gkMFAFormatDate(cred.last_used_at))
        : gkMFAI18n.passkeyNeverUsed);
    if (cred.registered_host) facts.push(gkMFAI18n.passkeySetUpOn.replace('{host}', cred.registered_host));
    const meta = document.createElement('div');
    meta.className = 'text-xs mt-0.5';
    meta.style.color = 'var(--gk-text-muted)';
    meta.textContent = facts.join(' · ');
    info.appendChild(meta);

    if (cred.usable_here === false) {
        const warning = document.createElement('div');
        warning.className = 'text-xs mt-0.5 font-medium';
        warning.style.color = 'var(--gk-warning)';
        warning.textContent = gkMFAI18n.passkeyOtherAddress;
        info.appendChild(warning);
    }
    row.appendChild(info);

    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'gk-btn-secondary text-sm';
    remove.textContent = gkMFAI18n.passkeyRemove;
    remove.addEventListener('click', () => gkMFAConfirmRemovePasskey(cred));
    row.appendChild(remove);
    return row;
}

function gkMFAOpenConfirm({ title, message, warning, buttonLabel, action }) {
    gkMFAConfirmAction = action;
    gkMFASetText('mfa-confirm-title', title);
    gkMFASetText('mfa-confirm-message', message);
    gkMFASetText('mfa-confirm-warning', warning || '');
    gkMFAShow('mfa-confirm-warning', Boolean(warning));
    gkMFASetText('mfa-confirm-btn', buttonLabel);
    gkMFAElement('mfa-confirm-password').value = '';
    gkMFAShow('mfa-confirm-error', false);
    gkMFAShow('mfa-confirm-modal', true);
    setTimeout(() => gkMFAElement('mfa-confirm-password').focus(), 0);
}

function gkMFACloseConfirm() {
    gkMFAShow('mfa-confirm-modal', false);
    gkMFAElement('mfa-confirm-password').value = '';
    gkMFAConfirmAction = null;
}

async function gkMFASubmitConfirm() {
    const password = gkMFAElement('mfa-confirm-password').value;
    const errorEl = gkMFAElement('mfa-confirm-error');
    const btn = gkMFAElement('mfa-confirm-btn');
    if (!password) {
        errorEl.textContent = gkMFAI18n.passwordRequired;
        errorEl.classList.remove('hidden');
        return;
    }
    if (!gkMFAConfirmAction) return;
    btn.disabled = true;
    errorEl.classList.add('hidden');
    try {
        await gkMFAConfirmAction(password);
    } catch (error) {
        errorEl.textContent = error.message || gkMFAI18n.genericError;
        errorEl.classList.remove('hidden');
    } finally {
        btn.disabled = false;
    }
}

function gkMFAConfirmRemovePasskey(cred) {
    const lastFactor = gkMFAState.keyCount === 1 && !gkMFAState.hasTOTP;
    gkMFAOpenConfirm({
        title: gkMFAI18n.passkeyRemoveTitle,
        message: gkMFAI18n.passkeyRemoveMessage.replace('{name}', cred.name),
        warning: lastFactor ? gkMFAI18n.passkeyRemoveLastWarning : '',
        buttonLabel: gkMFAI18n.passkeyRemove,
        action: async (password) => {
            const data = await gkMFARequest('/webauthn/credentials/' + encodeURIComponent(cred.id), {
                method: 'DELETE',
                body: JSON.stringify({ password: password })
            });
            if (!data.success) throw new Error(data.error || gkMFAI18n.genericError);
            gkMFACloseConfirm();
            window.location.reload();
        }
    });
}

function gkMFAConfirmNewRecoveryCodes() {
    gkMFAOpenConfirm({
        title: gkMFAI18n.recoveryCodesNew,
        message: gkMFAI18n.recoveryCodesNewMessage,
        buttonLabel: gkMFAI18n.recoveryCodesNew,
        action: async (password) => {
            const data = await gkMFARequest('/recovery-codes', {
                method: 'POST',
                body: JSON.stringify({ password: password })
            });
            if (!data.success) throw new Error(data.error || gkMFAI18n.genericError);
            gkMFACloseConfirm();
            gkMFAShowRecoveryCodes(data.recovery_codes, false);
        }
    });
}

// Shows recovery codes once. The modal only closes by reloading, after the
// user confirms they saved them. forPasskey explains why a passkey came with codes.
function gkMFAShowRecoveryCodes(codes, forPasskey) {
    const list = gkMFAElement('mfa-recovery-codes-list');
    list.replaceChildren(...codes.map(code => {
        const item = document.createElement('div');
        item.className = 'px-2 py-1 rounded';
        item.style.background = 'var(--gk-bg-base)';
        item.style.color = 'var(--gk-text-primary)';
        item.textContent = code;
        return item;
    }));
    gkMFAShow('mfa-recovery-codes-passkey-intro', forPasskey);
    gkMFAShow('mfa-recovery-codes-modal', true);
}
