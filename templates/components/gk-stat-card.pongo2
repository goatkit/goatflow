{# gk-stat-card — Dashboard metric card #}
{# Variables: #}
{#   value: the main number/stat (e.g., "42", "98%") #}
{#   label: description text (e.g., "Open Tickets") #}
{#   icon: optional FontAwesome icon class #}
{#   color: optional accent color (default: primary) #}
{#   trend: optional trend indicator ("up", "down", "flat") #}
{#   trend_value: optional trend text (e.g., "+12%", "-3") #}
{#   url: optional link when card is clicked #}

{% if url %}<a href="{{ url }}" class="block">{% endif %}
<div class="gk-stat-card p-4 rounded-lg transition-colors {% if url %}hover:opacity-90 cursor-pointer{% endif %}"
     style="background: var(--gk-bg-surface); border: 1px solid var(--gk-border-default);"
     role="figure"
     aria-label="{{ label }}: {{ value }}">
    <div class="flex items-start justify-between">
        <div>
            <p class="text-2xl font-bold" style="color: {{ color|default:"var(--gk-primary)" }};">
                {{ value }}
            </p>
            <p class="text-xs mt-1 font-medium" style="color: var(--gk-text-muted);">
                {{ label }}
            </p>
        </div>
        {% if icon %}
        <div class="p-2 rounded-lg" style="background: {{ color|default:"var(--gk-primary)" }}15;">
            <i class="fa-solid {{ icon }} text-lg" style="color: {{ color|default:"var(--gk-primary)" }};" aria-hidden="true"></i>
        </div>
        {% endif %}
    </div>
    {% if trend %}
    <div class="mt-3 flex items-center gap-1 text-xs">
        {% if trend == "up" %}
        <i class="fa-solid fa-arrow-up" style="color: var(--gk-success);" aria-hidden="true"></i>
        <span style="color: var(--gk-success);">{{ trend_value }}</span>
        {% elif trend == "down" %}
        <i class="fa-solid fa-arrow-down" style="color: var(--gk-error);" aria-hidden="true"></i>
        <span style="color: var(--gk-error);">{{ trend_value }}</span>
        {% else %}
        <i class="fa-solid fa-minus" style="color: var(--gk-text-muted);" aria-hidden="true"></i>
        <span style="color: var(--gk-text-muted);">{{ trend_value|default:t("components.stat_card.no_change")|default:"No change" }}</span>
        {% endif %}
    </div>
    {% endif %}
</div>
{% if url %}</a>{% endif %}
