{% extends "layouts/base.pongo2" %}

{% block title %}{{ t("customer.knowledge_base.title") }} - GoatFlow{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen">
    <!-- Knowledge Base Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold gk-heading">
            <span class="gk-text-gradient">{{ t("customer.knowledge_base.title") }}</span>
        </h1>
        <p class="mt-4" style="color: var(--gk-text-secondary);">
            {{ t("customer.knowledge_base.description") }}
        </p>
    </div>

    <!-- Knowledge Base Content -->
    <div id="kb-content" class="space-y-4">
        <!-- Knowledge Base content will be loaded here by JavaScript -->
        <div class="text-center py-12">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
            <p class="mt-4" style="color: var(--gk-text-muted);">{{ t("customer.loading") }}</p>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Load knowledge base articles via AJAX
    fetch('/knowledge-base', {
        credentials: 'include'
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Network response was not ok');
        }
        return response.json();
    })
    .then(data => {
        const container = document.getElementById('kb-content');
        if (data.Articles && data.Articles.length > 0) {
            container.innerHTML = data.Articles.map(article => `
                <div class="gk-card-glow p-4 transition-shadow duration-200">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-medium" style="color: var(--gk-text-primary);">${article.Title}</h3>
                            <p class="mt-2" style="color: var(--gk-text-secondary);">${article.Summary}</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <span class="px-2 py-1 text-xs font-medium rounded" style="background: var(--gk-bg-elevated); color: var(--gk-text-muted);">${article.Category}</span>
                                <span class="px-2 py-1 text-xs font-medium rounded" style="background: var(--gk-primary-subtle); color: var(--gk-primary);">${article.Visibility}</span>
                            </div>
                            <p class="text-sm" style="color: var(--gk-text-muted);">${article.UpdatedAt}</p>
                        </div>
                    </div>
                </div>
            `).join('');
        } else {
            container.innerHTML = `
                <div class="text-center py-8">
                    <p style="color: var(--gk-text-muted);">{{ t("customer.knowledge_base.no_articles") }}</p>
                </div>
            `;
        }
    })
    .catch(error => {
        console.error('Error loading knowledge base:', error);
        const container = document.getElementById('kb-content');
        container.innerHTML = `
            <div class="text-center py-8">
                <p style="color: var(--gk-text-red);">{{ t("customer.error_loading") }}</p>
            </div>
        `;
    });
});
</script>
{% endblock %}