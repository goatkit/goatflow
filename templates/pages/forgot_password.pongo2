{% extends "layouts/auth.pongo2" %}

{% block title %}{{ t("self_service.forgot_password.title")|default:"Forgot Password" }} - GoatFlow{% endblock %}

{% block content %}
<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
    <div class="absolute top-4 right-4 z-10 flex items-center gap-2">
        {% include "partials/language_selector.pongo2" %}
        {% include "partials/login_theme_selector.pongo2" %}
    </div>

    <div class="sm:mx-auto sm:w-full sm:max-w-sm relative z-10">
        <div class="gk-logo-glow gk-float mx-auto w-24 h-24" style="color: var(--gk-primary);">
            <img class="w-full h-full" src="/static/favicon.svg?v={{ assetVersion }}" alt="GoatFlow Logo">
        </div>
        <h2 class="mt-6 text-center text-3xl gk-heading gk-text-gradient">
            {{ t("self_service.forgot_password.title")|default:"Forgot Password" }}
        </h2>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md relative z-10">
        <div class="gk-login-card">
            {% if Sent %}
            <div id="selfservice-message" class="rounded-md p-4 mb-4 text-sm" role="status" style="background: var(--gk-success-subtle); color: var(--gk-success); border: 1px solid var(--gk-success);">
                {{ t("self_service.forgot_password.success")|default:"If an account exists, a reset link has been sent." }}
            </div>
            {% else %}
            <p class="mb-5 text-sm" style="color: var(--gk-text-secondary);">
                {{ t("self_service.forgot_password.intro")|default:"Enter your username or email address. If it matches an account, we will email you a link to choose a new password." }}
            </p>

            {% if Error %}
            <div id="selfservice-error" class="rounded-md p-4 mb-4 text-sm" role="alert" style="background: var(--gk-error-subtle); color: var(--gk-error); border: 1px solid var(--gk-error);">
                {{ Error }}
            </div>
            {% endif %}

            <form class="space-y-5" action="{{ Portal.ForgotURL }}" method="POST">
                <div>
                    <label for="identifier" class="form-label">{{ t("self_service.forgot_password.identifier_label")|default:"Username or email address" }}</label>
                    <div class="mt-2">
                        <input id="identifier" name="identifier" type="text" autocomplete="username" required autofocus maxlength="200"
                               class="gk-input-neon" value="{{ Identifier }}">
                    </div>
                </div>
                <div class="pt-2">
                    <button type="submit" class="gk-btn-neon w-full">
                        {{ t("self_service.forgot_password.submit")|default:"Send Reset Link" }}
                    </button>
                </div>
            </form>
            {% endif %}

            <p class="mt-6 text-center text-sm">
                <a href="{{ Portal.LoginURL }}" class="gk-link-neon">{{ t("auth.back_to_login")|default:"Back to Login" }}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
