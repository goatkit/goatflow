{% extends "layouts/base.pongo2" %}

{% block title %}{{ t("customer_company_users.title")|default:"Customer Company Users" }}: {{ Company.Name }} - GoatFlow Admin{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen">
    {% include "partials/customer_company_header.pongo2" with active="users" %}

    <div class="gk-card-glow overflow-hidden rounded-lg">
        <div class="px-6 py-4 flex items-center justify-between border-b" style="border-color: var(--gk-border-default);">
            <div>
                <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("customer_company_users.heading")|default:"Customer Users" }}</h2>
                <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">{{ t("customer_company_users.description")|default:"Customer users that belong to this company." }}</p>
            </div>
            <a href="/admin/customer-users" class="gk-btn-secondary">{{ t("customer_company_users.manage_users")|default:"Manage customer users" }}</a>
        </div>
        <div class="overflow-x-auto">
            <table class="gk-table">
                <thead>
                    <tr>
                        <th scope="col">{{ t("customer_company_users.columns.login")|default:"Login" }}</th>
                        <th scope="col">{{ t("customer_company_users.columns.name")|default:"Name" }}</th>
                        <th scope="col">{{ t("customer_company_users.columns.email")|default:"Email" }}</th>
                        <th scope="col">{{ t("customer_company_users.columns.phone")|default:"Phone" }}</th>
                        <th scope="col" class="text-right">{{ t("customer_company_users.columns.tickets")|default:"Tickets" }}</th>
                        <th scope="col">{{ t("customer_company_users.columns.status")|default:"Status" }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in Users %}
                    <tr data-login="{{ u.Login }}">
                        <td class="whitespace-nowrap">
                            <a href="/admin/customer-users?search={{ u.Login|urlencode }}" class="text-sm font-medium hover:underline" style="color: var(--gk-primary);">{{ u.Login }}</a>
                        </td>
                        <td class="text-sm" style="color: var(--gk-text-primary);">{{ u.FirstName }} {{ u.LastName }}</td>
                        <td class="text-sm" style="color: var(--gk-text-primary);">{% if u.Email %}<a href="mailto:{{ u.Email }}" class="hover:underline">{{ u.Email }}</a>{% endif %}</td>
                        <td class="text-sm whitespace-nowrap" style="color: var(--gk-text-muted);">{{ u.Phone }}{% if u.Phone and u.Mobile %}<br>{% endif %}{{ u.Mobile }}</td>
                        <td class="text-sm text-right" style="color: var(--gk-text-primary);">{{ u.TicketCount }}</td>
                        <td class="whitespace-nowrap">
                            <span class="gk-badge {% if u.ValidID == 1 %}gk-badge-success{% else %}gk-badge-error{% endif %}">{{ u.ValidName }}</span>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-sm" style="color: var(--gk-text-muted);">
                            {{ t("customer_company_users.empty")|default:"This company has no customer users yet." }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
