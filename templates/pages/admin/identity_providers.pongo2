{% extends "layouts/base.pongo2" %}

{% block title %}{{ t("admin.identity_providers.title")|default:"Identity Providers" }} - GoatFlow Admin{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen">
    <!-- Page header -->
    <header class="mb-8">
        <div class="sm:flex sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold gk-heading">
                    <span class="gk-text-gradient">{{ t("admin.identity_providers.title")|default:"Identity Providers" }}</span>
                </h1>
                <p class="mt-2 text-sm" style="color: var(--gk-text-muted);">{{ t("admin.identity_providers.description")|default:"Manage external identity providers for user authentication." }}</p>
            </div>
            <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
                <a href="/admin/identity-providers/new" class="gk-btn-neon" title="{{ t('admin.identity_providers.add') }}">
                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    {{ t("admin.identity_providers.add")|default:"Add Provider" }}
                </a>
            </div>
        </div>
    </header>

    <!-- Providers Table -->
    <div class="gk-card-glow overflow-hidden rounded-lg">
        <table class="gk-table">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">{{ t("admin.identity_providers.name")|default:"Name" }}</th>
                    <th scope="col">{{ t("admin.identity_providers.type")|default:"Type" }}</th>
                    <th scope="col">{{ t("admin.identity_providers.client_id")|default:"Client ID" }}</th>
                    <th scope="col">{{ t("admin.identity_providers.client_id")|default:"Org" }}</th>
                    <th scope="col">{{ t("common.status")|default:"Status" }}</th>
                    <th scope="col">{{ t("admin.identity_providers.provision")|default:"Auto-provision" }}</th>
                    <th scope="col">{{ t("common.created")|default:"Created" }}</th>
                    <th scope="col">{{ t("common.actions")|default:"Actions" }}</th>
                </tr>
            </thead>
            <tbody>
                {% for p in Providers %}
                <tr>
                    <td style="color: var(--gk-text-muted);">{{ p.ID }}</td>
                    <td>
                        <a href="/admin/identity-providers/{{ p.ID }}/edit" class="font-medium" style="color: var(--gk-primary);">{{ p.Name }}</a>
                    </td>
                    <td>
                        {% set iconClass = "" %}
                        {% if p.ProviderType == "google" %}
                            {% set iconClass = "gk-badge-accent" %}
                        {% elif p.ProviderType == "oidc" %}
                            {% set iconClass = "gk-badge-info" %}
                        {% elif p.ProviderType == "github" %}
                            {% set iconClass = "gk-badge-success" %}
                        {% else %}
                            {% set iconClass = "gk-badge-muted" %}
                        {% endif %}
                        <span class="gk-badge {{ iconClass }}">{{ p.ProviderType|upper }}</span>
                    </td>
                    <td class="max-w-xs truncate font-mono text-xs">{{ p.ClientID }}</td>
                    <td>{{ p.OrgStr }}</td>
                    <td>
                        {% if p.Enabled %}
                        <span class="gk-badge gk-badge-success">{{ t("labels.enabled")|default:"Enabled" }}</span>
                        {% else %}
                        <span class="gk-badge gk-badge-error">{{ t("labels.disabled")|default:"Disabled" }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if p.AutoProvision %}
                        <span class="gk-badge gk-badge-info">{{ t("admin.identity_providers.yes")|default:"Yes" }}</span>
                        {% else %}
                        <span style="color: var(--gk-text-muted);">{{ t("admin.identity_providers.no")|default:"No" }}</span>
                        {% endif %}
                    </td>
                    <td style="color: var(--gk-text-muted);">{{ p.CreateTime }}</td>
                    <td>
                        <div class="flex items-center justify-end space-x-2">
                            {% if p.Enabled %}
                            <button onclick="toggleProvider({{ p.ID }}, 'disable')"
                                class="p-1 rounded transition-colors hover:bg-white/10"
                                style="color: var(--gk-error);"
                                title="{{ t('admin.identity_providers.disable')|default:"Disable" }}"
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                </svg>
                            </button>
                            {% else %}
                            <button onclick="toggleProvider({{ p.ID }}, 'enable')"
                                class="p-1 rounded transition-colors hover:bg-white/10"
                                style="color: var(--gk-success);"
                                title="{{ t('admin.identity_providers.enable')|default:"Enable" }}"
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </button>
                            {% endif %}
                            <a href="/admin/identity-providers/{{ p.ID }}/edit"
                                class="p-1 rounded transition-colors hover:bg-white/10"
                                style="color: var(--gk-primary);"
                                title="{{ t('common.edit')|default:"Edit" }}"
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </a>
                            <button onclick="deleteProvider({{ p.ID }}, '{{ p.Name }}')"
                                class="p-1 rounded transition-colors hover:bg-white/10"
                                style="color: var(--gk-error);"
                                title="{{ t('common.delete')|default:"Delete" }}"
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </div>
                    </td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="8" class="px-6 py-12 text-center" style="color: var(--gk-text-muted);">
                        <svg class="mx-auto h-12 w-12 mb-3" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2 2 2 0 002-2v-3.5M8 20H13a2 2 0 002-2v-3.5A2.5 2.5 0 0013 13H11a2.5 2.5 0 00-2 2v3.5A2.5 2.5 0 0011 20"/>
                        </svg>
                        <p class="text-sm mb-4">{{ t("admin.identity_providers.no_providers")|default:"No identity providers configured yet." }}</p>
                        <a href="/admin/identity-providers/new" class="gk-btn-neon">
                            {{ t("admin.identity_providers.add")|default:"Add Provider" }}
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
async function toggleProvider(id, action) {
    const label = action === 'enable' ? 'enable' : 'disable';
    if (!confirm('{{ t("admin.identity_providers.confirm.toggle")|default:"Are you sure you want to " + action + " this provider?" }}')) {
        return;
    }

    try {
        const response = await fetch('/admin/identity-providers/' + id + '/' + action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();
        if (result.success) {
            showToast(result.enabled ? 'Provider enabled' : 'Provider disabled', 'success');
            setTimeout(() => window.location.reload(), 500);
        } else {
            showToast('Error: ' + (result.error || 'Unknown error'), 'error');
        }
    } catch (error) {
        showToast('Error: ' + error.message, 'error');
    }
}

async function deleteProvider(id, name) {
    if (!confirm('{{ t("admin.identity_providers.confirm.delete")|default:"Are you sure you want to delete " + name + "?" }}')) {
        return;
    }

    try {
        const response = await fetch('/admin/identity-providers/' + id + '/delete', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        });

        const result = await response.json();
        if (result.success) {
            showToast('Provider deleted', 'success');
            setTimeout(() => window.location.reload(), 500);
        } else {
            showToast('Error: ' + (result.error || 'Unknown error'), 'error');
        }
    } catch (error) {
        showToast('Error: ' + error.message, 'error');
    }
}

function showToast(message, type = 'info') {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-4 right-4 px-6 py-3 rounded-lg shadow-lg text-white z-50';
    toast.style.background = type === 'error' ? 'var(--gk-error)' : type === 'success' ? 'var(--gk-success)' : 'var(--gk-primary)';
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}
</script>
{% endblock %}