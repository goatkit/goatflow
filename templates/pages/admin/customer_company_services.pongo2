{% extends "layouts/base.pongo2" %}

{% block title %}{{ t("customer_company_services.title")|default:"Customer Company Services" }}: {{ Company.Name }} - GoatFlow Admin{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen">
    {% include "partials/customer_company_header.pongo2" with active="services" %}

    {% if Saved %}
    <div id="services-saved" role="status" class="mb-4 rounded-md p-4 text-sm" style="background: rgba(var(--gk-success-rgb), 0.1); border: 1px solid var(--gk-success); color: var(--gk-success);">
        {{ t("customer_company_services.saved")|default:"Service assignments saved." }}
    </div>
    {% endif %}

    <form method="post" action="/admin/customer/companies/{{ CompanyPath }}/services">
        <div class="gk-card-glow overflow-hidden rounded-lg">
            <div class="px-6 py-4 border-b" style="border-color: var(--gk-border-default);">
                <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("customer_company_services.heading")|default:"Services" }}</h2>
                <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">{{ t("customer_company_services.description")|default:"Services are assigned to customer users. Tick the customer users of this company who may use each service." }}</p>
            </div>

            {% if not Services %}
            <div class="px-6 py-12 text-center text-sm" style="color: var(--gk-text-muted);">
                {{ t("customer_company_services.no_services")|default:"There are no valid services." }}
                <a href="/admin/services" class="hover:underline" style="color: var(--gk-primary);">{{ t("customer_company_services.manage_services")|default:"Manage services" }}</a>
            </div>
            {% elif UserCount == 0 %}
            <div class="px-6 py-12 text-center text-sm" style="color: var(--gk-text-muted);">
                {{ t("customer_company_services.no_users")|default:"This company has no customer users, so there is nobody to assign services to." }}
            </div>
            {% else %}
            <div class="overflow-x-auto">
                <table class="gk-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ t("customer_company_services.columns.service")|default:"Service" }}</th>
                            <th scope="col" class="text-center">{{ t("customer_company_services.columns.assigned")|default:"Assigned" }}</th>
                            <th scope="col">{{ t("customer_company_services.columns.customer_users")|default:"Customer users" }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for s in Services %}
                        <tr data-service-id="{{ s.ID }}">
                            <td class="align-top">
                                <div class="text-sm font-medium" style="color: var(--gk-text-primary);">{{ s.Name }}</div>
                                {% if s.Comments %}<div class="text-xs" style="color: var(--gk-text-muted);">{{ s.Comments }}</div>{% endif %}
                            </td>
                            <td class="align-top text-center text-sm whitespace-nowrap" style="color: var(--gk-text-primary);">{{ s.AssignedCount }} / {{ UserCount }}</td>
                            <td class="align-top">
                                <div class="flex flex-wrap gap-x-6 gap-y-2">
                                    <label class="inline-flex items-center text-sm font-medium" style="color: var(--gk-text-secondary);">
                                        <input type="checkbox" class="h-4 w-4 rounded mr-2" style="accent-color: var(--gk-primary);" data-select-all="{{ s.ID }}" {% if s.AssignedCount == UserCount %}checked{% endif %}>
                                        {{ t("customer_company_services.all_users")|default:"All users" }}
                                    </label>
                                    {% for cell in s.Users %}
                                    <label class="inline-flex items-center text-sm" style="color: var(--gk-text-primary);" title="{{ cell.FullName }}">
                                        <input type="checkbox" name="assign" value="{{ s.ID }}:{{ cell.UserID }}" class="h-4 w-4 rounded mr-2" style="accent-color: var(--gk-primary);" data-service="{{ s.ID }}" {% if cell.Assigned %}checked{% endif %}>
                                        {{ cell.Login }}
                                    </label>
                                    {% endfor %}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="px-6 py-4 flex justify-end gap-3 border-t" style="border-color: var(--gk-border-default); background: var(--gk-bg-tertiary);">
                <a href="/admin/customer/companies" class="gk-btn-secondary">{{ t("common.cancel")|default:"Cancel" }}</a>
                <button type="submit" class="gk-btn-neon">{{ t("customer_company_services.save")|default:"Save assignments" }}</button>
            </div>
            {% endif %}
        </div>
    </form>
</div>

<script>
document.querySelectorAll('input[data-select-all]').forEach(function (all) {
    var boxes = document.querySelectorAll('input[data-service="' + all.dataset.selectAll + '"]');
    all.addEventListener('change', function () {
        boxes.forEach(function (b) { b.checked = all.checked; });
    });
    boxes.forEach(function (b) {
        b.addEventListener('change', function () {
            all.checked = Array.prototype.every.call(boxes, function (x) { return x.checked; });
        });
    });
});
</script>
{% endblock %}
