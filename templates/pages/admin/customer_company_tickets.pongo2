{% extends "layouts/base.pongo2" %}

{% block title %}{{ t("customer_company_tickets.title")|default:"Customer Company Tickets" }}: {{ Company.Name }} - GoatFlow Admin{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen">
    {% include "partials/customer_company_header.pongo2" with active="tickets" %}

    <div class="gk-card-glow overflow-hidden rounded-lg">
        <div class="px-6 py-4 flex items-center justify-between border-b" style="border-color: var(--gk-border-default);">
            <div>
                <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("customer_company_tickets.heading")|default:"Tickets" }}</h2>
                <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">{{ t("customer_company_tickets.description")|default:"Tickets of this company in the queues you can access, newest first." }}</p>
            </div>
            <span class="text-sm" style="color: var(--gk-text-muted);">{{ t("pagination.total")|default:"total" }}: <span id="company-ticket-total" style="color: var(--gk-text-primary);">{{ Total }}</span></span>
        </div>
        <div class="overflow-x-auto">
            <table class="gk-table">
                <thead>
                    <tr>
                        <th scope="col">{{ t("tickets.ticket_number")|default:"Ticket #" }}</th>
                        <th scope="col">{{ t("customer_company_tickets.columns.title")|default:"Title" }}</th>
                        <th scope="col">{{ t("customer_company_tickets.columns.customer_user")|default:"Customer User" }}</th>
                        <th scope="col">{{ t("tickets.queue")|default:"Queue" }}</th>
                        <th scope="col">{{ t("tickets.state")|default:"State" }}</th>
                        <th scope="col">{{ t("tickets.priority")|default:"Priority" }}</th>
                        <th scope="col">{{ t("tickets.age")|default:"Age" }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ticket in Tickets %}
                    <tr data-tn="{{ ticket.TN }}">
                        <td class="whitespace-nowrap">
                            <a href="/ticket/{{ ticket.TN }}" class="text-sm font-mono hover:underline" style="color: var(--gk-primary);">{{ ticket.TN }}</a>
                        </td>
                        <td class="text-sm" style="color: var(--gk-text-primary);">
                            <a href="/ticket/{{ ticket.TN }}" class="hover:underline">{{ ticket.Title }}</a>
                        </td>
                        <td class="text-sm whitespace-nowrap" style="color: var(--gk-text-primary);">{{ ticket.CustomerUser }}</td>
                        <td class="text-sm whitespace-nowrap" style="color: var(--gk-text-primary);">{{ ticket.Queue }}</td>
                        <td class="whitespace-nowrap">
                            <span class="gk-badge {% if ticket.StateType == "closed" or ticket.StateType == "removed" or ticket.StateType == "merged" %}gk-badge-muted{% elif ticket.StateType == "new" %}gk-badge-primary{% elif ticket.StateType == "pending reminder" or ticket.StateType == "pending auto" %}gk-badge-warning{% else %}gk-badge-success{% endif %}">{{ ticket.State }}</span>
                        </td>
                        <td class="text-sm whitespace-nowrap" style="color: var(--gk-text-primary);">{{ ticket.Priority }}</td>
                        <td class="text-sm whitespace-nowrap" style="color: var(--gk-text-muted);" title="{{ ticket.CreateTime|date:"2006-01-02 15:04" }}">
                            {{ ticket.AgeValue }}
                            {% if ticket.AgeUnit == "days" %}{{ t("time.days")|default:"days" }}{% elif ticket.AgeUnit == "hours" %}{{ t("time.hours")|default:"hours" }}{% else %}{{ t("time.minutes")|default:"minutes" }}{% endif %}
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="7" class="px-6 py-12 text-center text-sm" style="color: var(--gk-text-muted);">
                            {{ t("customer_company_tickets.empty")|default:"No tickets for this company in the queues you can access." }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if TotalPages > 1 %}
        <nav class="px-6 py-4 flex items-center justify-between border-t" style="border-color: var(--gk-border-default);" aria-label="{{ t("pagination.page")|default:"Page" }}">
            <span class="text-sm" style="color: var(--gk-text-muted);">{{ t("pagination.page")|default:"Page" }} {{ Page }} {{ t("pagination.of")|default:"of" }} {{ TotalPages }}</span>
            <div class="flex gap-2">
                {% if Page > 1 %}<a href="/admin/customer/companies/{{ CompanyPath }}/tickets?page={{ PrevPage }}" class="gk-btn-secondary">{{ t("pagination.previous")|default:"Previous" }}</a>{% endif %}
                {% if Page < TotalPages %}<a href="/admin/customer/companies/{{ CompanyPath }}/tickets?page={{ NextPage }}" class="gk-btn-secondary">{{ t("pagination.next")|default:"Next" }}</a>{% endif %}
            </div>
        </nav>
        {% endif %}
    </div>
</div>
{% endblock %}
