{% extends "layouts/base.pongo2" %}

{% block title %}{{ t("admin_reports.title") }} - GoatFlow Admin{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen" id="reports-page">
    <nav class="flex items-center text-sm mb-4" aria-label="Breadcrumb">
        <a href="/admin" class="gk-link-neon">{{ t("navigation.admin") }}</a>
        <svg class="mx-2 h-4 w-4" style="color: var(--gk-text-muted);" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
        <span class="font-medium" style="color: var(--gk-text-primary);">{{ t("admin_reports.title") }}</span>
    </nav>

    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold gk-heading"><span class="gk-text-gradient">{{ t("admin_reports.title") }}</span></h1>
            <p class="mt-2 text-sm" style="color: var(--gk-text-secondary);">{{ t("admin_reports.description") }}</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <div>
                <label for="report-period" class="gk-form-label">{{ t("admin_reports.period_label") }}</label>
                <select id="report-period" class="gk-select-neon mt-1">
                    <option value="24h">{{ t("admin_reports.period_24h") }}</option>
                    <option value="7d" selected>{{ t("admin_reports.period_7d") }}</option>
                    <option value="30d">{{ t("admin_reports.period_30d") }}</option>
                </select>
            </div>
            <div>
                <label for="report-trend" class="gk-form-label">{{ t("admin_reports.trend_label") }}</label>
                <select id="report-trend" class="gk-select-neon mt-1">
                    <option value="period=daily&days=7">{{ t("admin_reports.trend_daily_7") }}</option>
                    <option value="period=daily&days=30" selected>{{ t("admin_reports.trend_daily_30") }}</option>
                    <option value="period=monthly&months=12">{{ t("admin_reports.trend_monthly_12") }}</option>
                </select>
            </div>
        </div>
    </div>

    <div id="report-error-forbidden" class="hidden gk-card-glow p-4 mb-6" role="alert" style="border-color: var(--gk-warning);">
        <p style="color: var(--gk-text-primary);">{{ t("admin_reports.error_forbidden") }}</p>
    </div>
    <div id="report-error-generic" class="hidden gk-card-glow p-4 mb-6" role="alert" style="border-color: var(--gk-error);">
        <p style="color: var(--gk-text-primary);">{{ t("admin_reports.error_generic") }}</p>
    </div>
    <p id="report-scope-note" class="text-xs mb-4" style="color: var(--gk-text-muted);">{{ t("admin_reports.scope_note") }}</p>

    <!-- Overview (all time, queues the viewer can read) -->
    <section class="grid grid-cols-2 gap-4 lg:grid-cols-4 mb-8" aria-label="{{ t('admin_reports.overview_heading') }}">
        <article class="gk-stat-card">
            <h2 class="gk-stat-label">{{ t("admin_reports.total_tickets") }}</h2>
            <p class="gk-stat-value mt-2" data-stat="total_tickets">–</p>
        </article>
        <article class="gk-stat-card">
            <h2 class="gk-stat-label">{{ t("admin_reports.open_tickets") }}</h2>
            <p class="gk-stat-value mt-2" data-stat="open_tickets">–</p>
        </article>
        <article class="gk-stat-card warning">
            <h2 class="gk-stat-label">{{ t("admin_reports.pending_tickets") }}</h2>
            <p class="gk-stat-value mt-2" data-stat="pending_tickets">–</p>
        </article>
        <article class="gk-stat-card success">
            <h2 class="gk-stat-label">{{ t("admin_reports.closed_tickets") }}</h2>
            <p class="gk-stat-value mt-2" data-stat="closed_tickets">–</p>
        </article>
    </section>

    <!-- Trends -->
    <section class="gk-card-glow mb-8">
        <div class="gk-card-header flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("admin_reports.trends_heading") }}</h2>
            <dl class="flex flex-wrap gap-4 text-sm" style="color: var(--gk-text-secondary);">
                <div><dt class="inline">{{ t("admin_reports.created") }}:</dt> <dd class="inline font-semibold" data-trend-summary="total_created">–</dd></div>
                <div><dt class="inline">{{ t("admin_reports.closed") }}:</dt> <dd class="inline font-semibold" data-trend-summary="total_closed">–</dd></div>
                <div><dt class="inline">{{ t("admin_reports.closure_rate") }}:</dt> <dd class="inline font-semibold" data-trend-summary="closure_rate">–</dd></div>
            </dl>
        </div>
        <div class="gk-card-body">
            <div class="flex items-center gap-4 text-xs mb-3" style="color: var(--gk-text-muted);">
                <span class="inline-flex items-center gap-1"><span class="inline-block h-3 w-3 rounded-sm" style="background: var(--gk-primary);"></span>{{ t("admin_reports.created") }}</span>
                <span class="inline-flex items-center gap-1"><span class="inline-block h-3 w-3 rounded-sm" style="background: var(--gk-success);"></span>{{ t("admin_reports.closed") }}</span>
            </div>
            <div id="trend-chart" class="flex items-end gap-1 h-48 overflow-x-auto" role="img" aria-label="{{ t('admin_reports.trends_heading') }}"></div>
            <div id="trend-labels" class="flex gap-1 mt-1 text-[10px] overflow-x-auto" style="color: var(--gk-text-muted);"></div>
        </div>
    </section>

    <div class="grid grid-cols-1 gap-8 xl:grid-cols-2 mb-8">
        <!-- Queues -->
        <section class="gk-card-glow overflow-hidden">
            <div class="gk-card-header">
                <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("admin_reports.queues_heading") }}</h2>
                <p class="mt-1 text-xs" style="color: var(--gk-text-muted);">{{ t("admin_reports.backlog_hint") }}</p>
            </div>
            <div class="overflow-x-auto">
                <table class="gk-table" id="report-queues">
                    <thead>
                        <tr>
                            <th scope="col">{{ t("admin_reports.queue") }}</th>
                            <th scope="col" class="text-right">{{ t("admin_reports.total_tickets") }}</th>
                            <th scope="col" class="text-right">{{ t("admin_reports.open_tickets") }}</th>
                            <th scope="col" class="text-right">{{ t("admin_reports.backlog") }}</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>

        <!-- Agents -->
        <section class="gk-card-glow overflow-hidden">
            <div class="gk-card-header">
                <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("admin_reports.agents_heading") }}</h2>
                <p class="mt-1 text-xs" style="color: var(--gk-text-muted);">{{ t("admin_reports.agents_hint") }}</p>
            </div>
            <div class="overflow-x-auto">
                <table class="gk-table" id="report-agents">
                    <thead>
                        <tr>
                            <th scope="col">{{ t("admin_reports.agent") }}</th>
                            <th scope="col" class="text-right">{{ t("admin_reports.assigned") }}</th>
                            <th scope="col" class="text-right">{{ t("admin_reports.closed") }}</th>
                            <th scope="col" class="text-right">{{ t("admin_reports.articles") }}</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- Customers -->
    <section class="gk-card-glow overflow-hidden mb-8">
        <div class="gk-card-header flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("admin_reports.customers_heading") }}</h2>
            <dl class="flex flex-wrap gap-4 text-sm" style="color: var(--gk-text-secondary);">
                <div><dt class="inline">{{ t("admin_reports.total_customers") }}:</dt> <dd class="inline font-semibold" data-customer-metric="total_customers">–</dd></div>
                <div><dt class="inline">{{ t("admin_reports.active_customers") }}:</dt> <dd class="inline font-semibold" data-customer-metric="active_customers">–</dd></div>
                <div><dt class="inline">{{ t("admin_reports.new_customers") }}:</dt> <dd class="inline font-semibold" data-customer-metric="new_customers_this_month">–</dd></div>
            </dl>
        </div>
        <div class="overflow-x-auto">
            <table class="gk-table" id="report-customers">
                <thead>
                    <tr>
                        <th scope="col">{{ t("admin_reports.customer") }}</th>
                        <th scope="col">{{ t("admin_reports.email") }}</th>
                        <th scope="col" class="text-right">{{ t("admin_reports.total_tickets") }}</th>
                        <th scope="col" class="text-right">{{ t("admin_reports.open_tickets") }}</th>
                        <th scope="col">{{ t("admin_reports.last_activity") }}</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <!-- Export -->
    <section class="gk-card-glow p-6">
        <h2 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("admin_reports.export_heading") }}</h2>
        <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">{{ t("admin_reports.export_description") }}</p>
        <div class="mt-4 flex flex-wrap gap-3">
            <a id="export-summary-csv" class="gk-btn-neon" data-export="type=summary&format=csv" href="/api/v1/statistics/export?type=summary&format=csv&period=7d"><i class="fa-solid fa-file-csv mr-2" aria-hidden="true"></i>{{ t("admin_reports.export_summary_csv") }}</a>
            <a id="export-tickets-csv" class="gk-btn-secondary" data-export="type=tickets&format=csv" href="/api/v1/statistics/export?type=tickets&format=csv&period=7d"><i class="fa-solid fa-file-csv mr-2" aria-hidden="true"></i>{{ t("admin_reports.export_tickets_csv") }}</a>
            <a id="export-summary-json" class="gk-btn-secondary" data-export="type=summary&format=json" href="/api/v1/statistics/export?type=summary&format=json&period=7d"><i class="fa-solid fa-file-code mr-2" aria-hidden="true"></i>{{ t("admin_reports.export_summary_json") }}</a>
        </div>
    </section>

    <template id="report-empty-row"><tr><td class="px-6 py-8 text-center text-sm" style="color: var(--gk-text-muted);">{{ t("admin_reports.no_data") }}</td></tr></template>
</div>

<script>
(function () {
    'use strict';

    var periodSelect = document.getElementById('report-period');
    var trendSelect = document.getElementById('report-trend');
    var errForbidden = document.getElementById('report-error-forbidden');
    var errGeneric = document.getElementById('report-error-generic');
    var lang = document.documentElement.lang || undefined;

    function fmt(n) {
        return typeof n === 'number' ? n.toLocaleString(lang) : '–';
    }

    function getJSON(url) {
        return fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } }).then(function (res) {
            if (!res.ok) {
                var err = new Error('HTTP ' + res.status);
                err.status = res.status;
                throw err;
            }
            return res.json();
        });
    }

    function showError(err) {
        if (err && (err.status === 403 || err.status === 401)) {
            errForbidden.classList.remove('hidden');
        } else {
            errGeneric.classList.remove('hidden');
        }
    }

    function cell(text, alignRight) {
        var td = document.createElement('td');
        td.textContent = text;
        if (alignRight) td.className = 'text-right tabular-nums';
        return td;
    }

    function fillTable(id, rows, toCells) {
        var table = document.getElementById(id);
        var tbody = table.querySelector('tbody');
        tbody.replaceChildren();
        if (!rows || rows.length === 0) {
            var empty = document.getElementById('report-empty-row').content.firstElementChild.cloneNode(true);
            empty.firstElementChild.colSpan = table.querySelectorAll('thead th').length;
            tbody.appendChild(empty);
            return;
        }
        rows.forEach(function (row) {
            var tr = document.createElement('tr');
            toCells(row).forEach(function (td) { tr.appendChild(td); });
            tbody.appendChild(tr);
        });
    }

    function loadOverview() {
        return getJSON('/api/v1/statistics/dashboard').then(function (data) {
            var o = data.overview || {};
            document.querySelectorAll('[data-stat]').forEach(function (el) {
                el.textContent = fmt(o[el.dataset.stat]);
            });
        });
    }

    function loadTrends() {
        return getJSON('/api/v1/statistics/trends?' + trendSelect.value).then(function (data) {
            var trends = data.trends || [];
            var s = data.summary || {};
            document.querySelector('[data-trend-summary="total_created"]').textContent = fmt(s.total_created);
            document.querySelector('[data-trend-summary="total_closed"]').textContent = fmt(s.total_closed);
            document.querySelector('[data-trend-summary="closure_rate"]').textContent =
                typeof s.closure_rate === 'number' ? s.closure_rate.toFixed(1) + '%' : '–';

            var chart = document.getElementById('trend-chart');
            var labels = document.getElementById('trend-labels');
            chart.replaceChildren();
            labels.replaceChildren();
            var max = 1;
            trends.forEach(function (p) { max = Math.max(max, p.created, p.closed); });
            var every = Math.max(1, Math.ceil(trends.length / 10));
            trends.forEach(function (p, i) {
                var group = document.createElement('div');
                group.className = 'flex flex-1 items-end gap-px h-full min-w-[14px]';
                group.title = p.date + ': ' + fmt(p.created) + ' / ' + fmt(p.closed);
                [[p.created, 'var(--gk-primary)'], [p.closed, 'var(--gk-success)']].forEach(function (bar) {
                    var b = document.createElement('div');
                    b.className = 'flex-1 rounded-t-sm';
                    b.style.background = bar[1];
                    b.style.height = (bar[0] / max * 100) + '%';
                    b.style.minHeight = bar[0] > 0 ? '2px' : '0';
                    group.appendChild(b);
                });
                chart.appendChild(group);
                var label = document.createElement('div');
                label.className = 'flex-1 min-w-[14px] text-center truncate';
                // Daily buckets are YYYY-MM-DD: show MM-DD so labels fit under the bars.
                label.textContent = i % every === 0 ? (p.date.length === 10 ? p.date.slice(5) : p.date) : '';
                labels.appendChild(label);
            });
        });
    }

    function loadQueues() {
        return getJSON('/api/v1/statistics/queues').then(function (data) {
            fillTable('report-queues', data.queues, function (q) {
                return [cell(q.queue_name), cell(fmt(q.total_tickets), true), cell(fmt(q.open_tickets), true), cell(fmt(q.backlog), true)];
            });
        });
    }

    function loadAgents() {
        return getJSON('/api/v1/statistics/agents?period=' + encodeURIComponent(periodSelect.value)).then(function (data) {
            var active = (data.agents || []).filter(function (a) {
                return a.tickets_assigned > 0 || a.tickets_closed > 0 || a.articles_created > 0;
            });
            fillTable('report-agents', active, function (a) {
                return [cell(a.agent_name), cell(fmt(a.tickets_assigned), true), cell(fmt(a.tickets_closed), true), cell(fmt(a.articles_created), true)];
            });
        });
    }

    function loadCustomers() {
        return getJSON('/api/v1/statistics/customers?top=10').then(function (data) {
            var m = data.customer_metrics || {};
            document.querySelectorAll('[data-customer-metric]').forEach(function (el) {
                el.textContent = fmt(m[el.dataset.customerMetric]);
            });
            fillTable('report-customers', data.top_customers, function (cu) {
                var last = cu.last_activity ? new Date(cu.last_activity).toLocaleString(lang) : '';
                return [cell(cu.customer_id), cell(cu.customer_email || ''), cell(fmt(cu.ticket_count), true), cell(fmt(cu.open_tickets), true), cell(last)];
            });
        });
    }

    function updateExportLinks() {
        document.querySelectorAll('[data-export]').forEach(function (a) {
            a.href = '/api/v1/statistics/export?' + a.dataset.export + '&period=' + encodeURIComponent(periodSelect.value);
        });
    }

    function run(loaders) {
        errForbidden.classList.add('hidden');
        errGeneric.classList.add('hidden');
        loaders.forEach(function (load) { load().catch(showError); });
    }

    periodSelect.addEventListener('change', function () {
        updateExportLinks();
        run([loadAgents]);
    });
    trendSelect.addEventListener('change', function () { run([loadTrends]); });

    updateExportLinks();
    run([loadOverview, loadTrends, loadQueues, loadAgents, loadCustomers]);
})();
</script>
{% endblock %}
