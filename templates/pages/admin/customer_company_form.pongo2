{% extends "layouts/base.pongo2" %}
{% block title %}{% if IsNew %}New{% else %}Edit{% endif %} Customer Company - Admin{% endblock %}
{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <p class="text-sm font-medium" style="color: var(--gk-text-muted);">Customer Companies</p>
      <h1 class="text-2xl font-bold gk-heading">
        <span class="gk-text-gradient">{% if IsNew %}Create New Customer Company{% else %}Edit Customer Company{% endif %}</span>
      </h1>
      <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">
  {% if IsNew %}Create a new customer organization{% else %}Manage company settings and portal customization{% endif %}
      </p>
    </div>
    <a href="/admin/customer/companies" class="gk-btn-secondary">
      <svg class="mr-2 -ml-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      Back to Companies
    </a>
  </div>

  <!-- Toast notification -->
  {% if SuccessMessage %}
  <div id="toast" class="fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50" style="background: var(--gk-success); color: white;">
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
      {{ SuccessMessage }}
    </div>
  </div>
  <script>
    setTimeout(function() {
      var toast = document.getElementById('toast');
      if (toast) {
        toast.remove();
      }
    }, 5000);
  </script>
  {% endif %}

  <div class="gk-card-glow rounded-lg overflow-hidden">
    <!-- Tabs -->
    <div style="border-bottom: 1px solid var(--gk-border-default);">
      <nav class="-mb-px flex space-x-8 px-6" aria-label="Tabs">
        <button onclick="switchTab('general')" id="tab-general" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" style="border-color: transparent; color: var(--gk-text-muted);">
          General
        </button>
        <button onclick="switchTab('portal')" id="tab-portal" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" style="border-color: transparent; color: var(--gk-text-muted);">
          Portal Settings
        </button>
        <button onclick="switchTab('services')" id="tab-services" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors" style="border-color: transparent; color: var(--gk-text-muted);">
          Services
        </button>
      </nav>
    </div>

    <!-- General Tab -->
    <div id="content-general" class="tab-content p-6">
      <form method="post" action="{% if IsNew %}/admin/customer/companies{% else %}/admin/customer/companies/{{ Company.customer_id|default:'' }}/edit{% endif %}">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <label for="customer_id" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Customer ID *</label>
            <input type="text" name="customer_id" id="customer_id"
                   value="{{ Company.customer_id|default:'' }}"
                   {% if not IsNew %}readonly{% endif %} required
                   class="gk-input-neon mt-1 block w-full">
          </div>

          <div>
            <label for="name" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Company Name *</label>
            <input type="text" name="name" id="name" value="{{ Company.name|default:'' }}" required
                   class="gk-input-neon mt-1 block w-full">
          </div>

          <div>
            <label for="street" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Street Address</label>
            <input type="text" name="street" id="street" value="{{ Company.street|default:'' }}"
                   class="gk-input-neon mt-1 block w-full">
          </div>

          <div>
            <label for="zip" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">ZIP/Postal Code</label>
            <input type="text" name="zip" id="zip" value="{{ Company.zip|default:'' }}"
                   class="gk-input-neon mt-1 block w-full">
          </div>

          <div>
            <label for="city" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">City</label>
            <input type="text" name="city" id="city" value="{{ Company.city|default:'' }}"
                   class="gk-input-neon mt-1 block w-full">
          </div>

          <div>
            <label for="country" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Country</label>
            {% include "partials/forms/country_select.pongo2" with field_id="country" field_name="country" selected_country=Company.country|default:'' select_classes="gk-select-neon mt-1 block w-full" %}
          </div>

          <div>
            <label for="url" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Website URL</label>
            <input type="url" name="url" id="url" value="{{ Company.url|default:'' }}"
                   class="gk-input-neon mt-1 block w-full">
          </div>

          <div>
            <label for="valid_id" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Status</label>
            <select name="valid_id" id="valid_id" class="gk-select-neon mt-1 block w-full">
              <option value="1" {% if Company.valid_id == 1 %}selected{% endif %}>Active</option>
              <option value="2" {% if Company.valid_id == 2 %}selected{% endif %}>Inactive</option>
            </select>
          </div>
        </div>

        <div class="mt-6">
          <label for="comments" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Comments</label>
          <textarea name="comments" id="comments" rows="3"
                    class="gk-input-neon mt-1 block w-full">{{ Company.comments|default:'' }}</textarea>
        </div>

        <div class="mt-6 flex justify-end">
          <button type="submit" class="gk-btn-neon">
            {% if IsNew %}Create Company{% else %}Update Company{% endif %}
          </button>
        </div>
      </form>
    </div>

    <!-- Portal Settings Tab -->
    <div id="content-portal" class="tab-content p-6 hidden">
      {% if IsNew %}
      <div class="rounded-md p-4 text-sm" style="border: 1px dashed var(--gk-border-default); background: var(--gk-bg-tertiary); color: var(--gk-text-secondary);">
        Save the company before configuring portal settings.
      </div>
      {% else %}
      <p class="text-sm mb-6" style="color: var(--gk-text-muted);">
        Values shown are inherited from the
        <a href="/admin/customer/portal/settings" style="color: var(--gk-primary); text-decoration: underline;">Default Customer Portal Settings</a>
        unless overridden below. Toggle <strong>Override default</strong> to set a value specific to this company.
      </p>
      <form method="post" action="/admin/customer/companies/{{ Company.customer_id }}/portal-settings" class="space-y-6">
        {# Boolean field — Enabled #}
        <div class="space-y-2 pb-4" style="border-bottom: 1px solid var(--gk-border-default);">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium" style="color: var(--gk-text-primary);">Portal enabled</p>
              <p class="text-xs" style="color: var(--gk-text-muted);">
                Default: <strong>{% if PortalDefaults.Enabled %}on{% else %}off{% endif %}</strong>
              </p>
            </div>
            <label class="inline-flex items-center gap-2 text-sm" style="color: var(--gk-text-secondary);">
              <input type="checkbox" name="override_enabled" value="1" {% if PortalOverrides.enabled %}checked{% endif %}
                     class="h-4 w-4" style="accent-color: var(--gk-primary);"
                     onchange="toggleOverride(this,'enabled')">
              Override default
            </label>
          </div>
          <label class="inline-flex items-center gap-2 text-sm" style="color: var(--gk-text-secondary);">
            <input type="hidden" name="enabled" value="0">
            <input type="checkbox" name="enabled" id="fld-enabled" value="1" {% if PortalEffective.Enabled %}checked{% endif %}
                   {% if not PortalOverrides.enabled %}disabled{% endif %}
                   class="h-4 w-4" style="accent-color: var(--gk-primary);">
            Customer portal is enabled for this company
          </label>
        </div>

        {# Boolean field — LoginRequired #}
        <div class="space-y-2 pb-4" style="border-bottom: 1px solid var(--gk-border-default);">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium" style="color: var(--gk-text-primary);">Require login</p>
              <p class="text-xs" style="color: var(--gk-text-muted);">
                Default: <strong>{% if PortalDefaults.LoginRequired %}on{% else %}off{% endif %}</strong>
              </p>
            </div>
            <label class="inline-flex items-center gap-2 text-sm" style="color: var(--gk-text-secondary);">
              <input type="checkbox" name="override_login_required" value="1" {% if PortalOverrides.login %}checked{% endif %}
                     class="h-4 w-4" style="accent-color: var(--gk-primary);"
                     onchange="toggleOverride(this,'login_required')">
              Override default
            </label>
          </div>
          <label class="inline-flex items-center gap-2 text-sm" style="color: var(--gk-text-secondary);">
            <input type="hidden" name="login_required" value="0">
            <input type="checkbox" name="login_required" id="fld-login_required" value="1" {% if PortalEffective.LoginRequired %}checked{% endif %}
                   {% if not PortalOverrides.login %}disabled{% endif %}
                   class="h-4 w-4" style="accent-color: var(--gk-primary);">
            Require authentication before portal access
          </label>
        </div>

        {# Text field — Title #}
        <div class="space-y-2 pb-4" style="border-bottom: 1px solid var(--gk-border-default);">
          <div class="flex items-center justify-between">
            <div>
              <label for="fld-title" class="text-sm font-medium" style="color: var(--gk-text-primary);">Portal title</label>
              <p class="text-xs" style="color: var(--gk-text-muted);">
                Default: <strong>{{ PortalDefaults.Title }}</strong>
              </p>
            </div>
            <label class="inline-flex items-center gap-2 text-sm" style="color: var(--gk-text-secondary);">
              <input type="checkbox" name="override_title" value="1" {% if PortalOverrides.title %}checked{% endif %}
                     class="h-4 w-4" style="accent-color: var(--gk-primary);"
                     onchange="toggleOverride(this,'title')">
              Override default
            </label>
          </div>
          <input type="text" name="title" id="fld-title"
                 value="{% if PortalOverrides.title %}{{ PortalEffective.Title }}{% endif %}"
                 placeholder="{{ PortalDefaults.Title }}"
                 {% if not PortalOverrides.title %}disabled{% endif %}
                 class="gk-input-neon block w-full">
        </div>

        {# Text field — FooterText #}
        <div class="space-y-2 pb-4" style="border-bottom: 1px solid var(--gk-border-default);">
          <div class="flex items-center justify-between">
            <div>
              <label for="fld-footer_text" class="text-sm font-medium" style="color: var(--gk-text-primary);">Footer text</label>
              <p class="text-xs" style="color: var(--gk-text-muted);">
                Default: <strong>{{ PortalDefaults.FooterText }}</strong>
              </p>
            </div>
            <label class="inline-flex items-center gap-2 text-sm" style="color: var(--gk-text-secondary);">
              <input type="checkbox" name="override_footer_text" value="1" {% if PortalOverrides.footer %}checked{% endif %}
                     class="h-4 w-4" style="accent-color: var(--gk-primary);"
                     onchange="toggleOverride(this,'footer_text')">
              Override default
            </label>
          </div>
          <input type="text" name="footer_text" id="fld-footer_text"
                 value="{% if PortalOverrides.footer %}{{ PortalEffective.FooterText }}{% endif %}"
                 placeholder="{{ PortalDefaults.FooterText }}"
                 {% if not PortalOverrides.footer %}disabled{% endif %}
                 class="gk-input-neon block w-full">
        </div>

        {# Text field — LandingPage #}
        <div class="space-y-2 pb-4" style="border-bottom: 1px solid var(--gk-border-default);">
          <div class="flex items-center justify-between">
            <div>
              <label for="fld-landing_page" class="text-sm font-medium" style="color: var(--gk-text-primary);">Landing page path</label>
              <p class="text-xs" style="color: var(--gk-text-muted);">
                Default: <strong>{{ PortalDefaults.LandingPage }}</strong>
              </p>
            </div>
            <label class="inline-flex items-center gap-2 text-sm" style="color: var(--gk-text-secondary);">
              <input type="checkbox" name="override_landing_page" value="1" {% if PortalOverrides.landing %}checked{% endif %}
                     class="h-4 w-4" style="accent-color: var(--gk-primary);"
                     onchange="toggleOverride(this,'landing_page')">
              Override default
            </label>
          </div>
          <input type="text" name="landing_page" id="fld-landing_page"
                 value="{% if PortalOverrides.landing %}{{ PortalEffective.LandingPage }}{% endif %}"
                 placeholder="{{ PortalDefaults.LandingPage }}"
                 {% if not PortalOverrides.landing %}disabled{% endif %}
                 class="gk-input-neon block w-full">
        </div>

        <div class="mt-6 flex justify-end">
          <button type="submit" class="gk-btn-neon">Save Portal Settings</button>
        </div>
      </form>
      <script>
        function toggleOverride(checkbox, fieldName) {
          var field = document.getElementById('fld-' + fieldName);
          if (!field) return;
          field.disabled = !checkbox.checked;
          if (!checkbox.checked) {
            if (field.type === 'checkbox') {
              // When reverting to default, reflect the default state in the UI.
              field.checked = false;
            } else {
              field.value = '';
            }
          }
        }
      </script>

      {# Plugin Capture — per-org setting stored on gk_organisation.captive_plugin. #}
      <div class="mt-10" style="border-top: 1px solid var(--gk-border-default); padding-top: 2rem;">
        <h3 class="text-lg font-medium" style="color: var(--gk-text-primary);">Plugin Capture</h3>
        <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">
          Replace the standard customer portal for this company with a single plugin.
          When set, customers of this company are redirected to the chosen plugin on login
          and can't navigate to the other portal pages (tickets, KB, profile). Leave as
          <em>None</em> to use the default customer portal.
        </p>

        {% if LinkedOrgID == 0 %}
        <div class="mt-4 rounded-md p-4 text-sm" style="border: 1px dashed var(--gk-border-default); background: var(--gk-bg-tertiary); color: var(--gk-text-secondary);">
          This company isn't linked to an organisation yet. Plugin capture applies at the
          organisation level — link this company to an organisation first from the GoatFictus
          admin <strong>Organisations</strong> page.
        </div>
        {% else %}
        <div class="mt-4 space-y-4">
          <div>
            <label for="captive_plugin" class="block text-sm font-medium" style="color: var(--gk-text-secondary);">Captive plugin</label>
            <select id="captive_plugin" class="gk-select-neon mt-1 block w-full" style="max-width: 32rem;">
              <option value="">— None (use standard customer portal) —</option>
              {% for p in EnabledPlugins %}
              <option value="{{ p }}" {% if p == CaptivePlugin %}selected{% endif %}>{{ p }}</option>
              {% endfor %}
            </select>
            <p class="mt-1 text-xs" style="color: var(--gk-text-muted);">
              Only plugins <strong>enabled</strong> for this organisation are listed here.
              To enable a new plugin, visit the per-plugin admin page first.
            </p>
          </div>
          <div>
            <button type="button" id="captive-save" class="gk-btn-neon">Save Capture Setting</button>
            <span id="captive-status" class="ml-3 text-sm" style="color: var(--gk-text-muted);"></span>
          </div>
        </div>
        <script>
        (function(){
          var saveBtn = document.getElementById('captive-save');
          var statusEl = document.getElementById('captive-status');
          if (!saveBtn) return;
          saveBtn.addEventListener('click', function(){
            var sel = document.getElementById('captive_plugin');
            var val = sel ? sel.value : '';
            statusEl.textContent = 'Saving…';
            fetch('/api/v1/organisations/{{ LinkedOrgID }}/captive-plugin', {
              method: 'POST',
              credentials: 'same-origin',
              headers: {'Content-Type': 'application/json'},
              body: JSON.stringify({captive_plugin: val})
            })
            .then(function(r){ return r.json().then(function(d){ return {ok:r.ok, data:d}; }); })
            .then(function(r){
              if (!r.ok) { statusEl.textContent = 'Failed: ' + ((r.data && r.data.error) || 'HTTP error'); return; }
              statusEl.textContent = val ? ('Captive to ' + val + '. Customers of this company will be redirected on next login.') : 'Capture cleared. Customers use the standard portal.';
            })
            .catch(function(e){ statusEl.textContent = 'Failed: ' + e; });
          });
        })();
        </script>
        {% endif %}
      </div>
      {% endif %}
    </div>

    <!-- Services Tab -->
    <div id="content-services" class="tab-content p-6 hidden">
      <div class="space-y-6">
        <div>
          <h3 class="text-lg font-medium" style="color: var(--gk-text-primary);">{{ t("customer_company_form.assigned_services")|default:"Assigned Services" }}</h3>
          <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">Manage which services are available to this customer company</p>
        </div>

        <div id="services-list" class="space-y-2">
          <!-- Services will be loaded here via JavaScript -->
        </div>

        <div class="mt-6 flex justify-end">
          <button type="button" onclick="saveServices()" class="gk-btn-neon">
            Save Services
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function switchTab(tabName) {
  // Hide all tabs
  document.querySelectorAll('.tab-content').forEach(tab => {
    tab.classList.add('hidden');
  });

  // Remove active state from all tab buttons
  document.querySelectorAll('[id^="tab-"]').forEach(btn => {
    btn.style.borderColor = 'transparent';
    btn.style.color = 'var(--gk-text-muted)';
  });

  // Show selected tab
  document.getElementById('content-' + tabName).classList.remove('hidden');
  const activeTab = document.getElementById('tab-' + tabName);
  activeTab.style.borderColor = 'var(--gk-primary)';
  activeTab.style.color = 'var(--gk-primary)';

  // Load services if switching to services tab
  if (tabName === 'services') {
    loadServices();
  }
}

{% if IsNew %}
function loadServices() {
  const container = document.getElementById('services-list');
  container.innerHTML = '<p class="text-sm" style="color: var(--gk-text-muted);">Save the company to assign services.</p>';
}

function saveServices() {
  alert('{{ t("messages.save_company_before_services")|default:"Save the company before assigning services." }}');
}
{% else %}
function loadServices() {
  fetch(`/admin/customer/companies/{{ Company.customer_id }}/services`)
    .then(response => response.json())
    .then(data => {
      const container = document.getElementById('services-list');
      container.innerHTML = '';

      data.services.forEach(service => {
        const div = document.createElement('div');
        div.className = 'flex items-center p-3 rounded-lg';
        div.style.border = '1px solid var(--gk-border-default)';
        div.innerHTML = `
          <input type="checkbox" name="services" value="${service.id}" ${service.assigned ? 'checked' : ''}
                 class="h-4 w-4 rounded focus:ring-2"
                 style="accent-color: var(--gk-primary); border-color: var(--gk-border-default);">
          <div class="ml-3">
            <div class="text-sm font-medium" style="color: var(--gk-text-primary);">${service.name}</div>
            <div class="text-xs" style="color: var(--gk-text-muted);">${service.description || 'No description'}</div>
          </div>
        `;
        container.appendChild(div);
      });
    });
}

function saveServices() {
  const selectedServices = Array.from(document.querySelectorAll('input[name="services"]:checked'))
    .map(cb => cb.value);

  fetch(`/admin/customer/companies/{{ Company.customer_id }}/services`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ services: selectedServices })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      alert('{{ t("messages.services_updated_success")|default:"Services updated successfully" }}');
    } else {
      alert('{{ t("messages.failed_update_services")|default:"Failed to update services" }}: ' + (data.error || '{{ t("messages.unknown_error")|default:"Unknown error" }}'));
    }
  });
}
{% endif %}

// Set active tab based on URL parameter or default to general
const urlParams = new URLSearchParams(window.location.search);
const activeTab = urlParams.get('tab') || 'general';
switchTab(activeTab);
</script>
{% endblock %}
