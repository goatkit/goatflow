{% extends "layouts/base.pongo2" %}

{% block title %}{{ t("admin.plugins")|default:"Plugins" }} - {{ t("app.name") }}{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 min-h-screen">
    <!-- Page header -->
    <header class="mb-8">
        <div class="sm:flex sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold gk-heading">
                    <span class="gk-text-gradient">{{ t("admin.plugins")|default:"Plugins" }}</span>
                </h1>
                <p class="mt-2 text-sm" style="color: var(--gk-text-secondary);">{{ t("admin.plugins_description")|default:"Manage installed plugins and extensions" }}</p>
            </div>
            <div class="mt-4 sm:mt-0 flex gap-2">
                <a
                    href="/admin/marketplace"
                    title="{{ t("admin.marketplace_tooltip")|default:"Browse and install plugins from the marketplace" }}"
                    class="gk-btn-neon"
                >
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    {{ t("admin.marketplace")|default:"Marketplace" }}
                </a>
                <a
                    href="/admin/plugin-uis"
                    title="{{ t("admin.plugin_uis_tooltip")|default:"Manage plugin UI surfaces" }}"
                    class="gk-btn-secondary"
                >
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H8l-4 4V5z" />
                    </svg>
                    {{ t("admin.plugin_uis")|default:"Plugin UIs" }}
                </a>
                <a
                    href="/admin/plugins/logs"
                    title="{{ t("admin.view_logs_tooltip")|default:"View plugin logs" }}"
                    class="gk-btn-secondary"
                >
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    {{ t("admin.view_logs")|default:"View Logs" }}
                </a>
                <button
                    type="button"
                    onclick="showUploadModal()"
                    title="{{ t("admin.upload_plugin_tooltip")|default:"Upload a new plugin" }}"
                    class="gk-btn-neon"
                >
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                    </svg>
                    {{ t("admin.upload_plugin")|default:"Upload Plugin" }}
                </button>
            </div>
        </div>
    </header>

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5 mb-8">
        <div class="gk-card p-5">
            <div class="text-sm font-medium" style="color: var(--gk-text-muted);">{{ t("admin.plugins_total")|default:"Total Plugins" }}</div>
            <div class="mt-2 text-2xl font-bold" style="color: var(--gk-text-primary);" id="stat-total">-</div>
        </div>
        <div class="gk-card p-5">
            <div class="text-sm font-medium" style="color: var(--gk-text-muted);">{{ t("admin.plugins_enabled")|default:"Enabled" }}</div>
            <div class="mt-2 text-2xl font-bold" style="color: var(--gk-success);" id="stat-enabled">-</div>
        </div>
        <div class="gk-card p-5">
            <div class="text-sm font-medium" style="color: var(--gk-text-muted);">{{ t("admin.plugins_disabled")|default:"Disabled" }}</div>
            <div class="mt-2 text-2xl font-bold" style="color: var(--gk-warning);" id="stat-disabled">-</div>
        </div>
        <div class="gk-card p-5">
            <div class="text-sm font-medium" style="color: var(--gk-text-muted);">{{ t("admin.plugins_healthy")|default:"Healthy" }}</div>
            <div class="mt-2 text-2xl font-bold" style="color: var(--gk-success);" id="stat-healthy">-</div>
        </div>
        <div class="gk-card p-5">
            <div class="text-sm font-medium" style="color: var(--gk-text-muted);">{{ t("admin.plugins_unhealthy")|default:"Unhealthy" }}</div>
            <div class="mt-2 text-2xl font-bold" style="color: var(--gk-error);" id="stat-unhealthy">-</div>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="mb-6 gk-card p-4">
        <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-1">
                <label for="pluginSearch" class="sr-only">{{ t("admin.search_plugins")|default:"Search plugins" }}</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                    <input
                        type="text"
                        id="pluginSearch"
                        name="search"
                        class="gk-input-neon pl-10 pr-10"
                        placeholder="{{ t("admin.search_plugins_placeholder")|default:"Search by name or description..." }}"
                        oninput="handleSearchInput()"
                    >
                    <!-- Clear button -->
                    <button
                        id="clearSearchBtn"
                        onclick="clearSearch()"
                        class="absolute inset-y-0 right-0 pr-3 flex items-center"
                        style="display: none;"
                        title="{{ t("admin.clear_search")|default:"Clear search" }}"
                    >
                        <svg class="h-5 w-5" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="flex gap-2">
                <select id="statusFilter" onchange="filterAndRender()" class="gk-select-neon">
                    <option value="">{{ t("admin.all_status")|default:"All Status" }}</option>
                    <option value="enabled">{{ t("admin.enabled")|default:"Enabled" }}</option>
                    <option value="disabled">{{ t("admin.disabled")|default:"Disabled" }}</option>
                </select>
                <button
                    type="button"
                    onclick="clearFilters()"
                    title="{{ t("admin.clear_filters")|default:"Clear all filters" }}"
                    class="gk-btn-secondary"
                >
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                    </svg>
                    <span class="ml-2">{{ t("admin.clear")|default:"Clear" }}</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Plugins table -->
    <div class="gk-card-glow overflow-hidden rounded-lg">
        <table class="gk-table" id="pluginsTable">
            <thead>
                <tr>
                    <th scope="col" class="cursor-pointer hover:text-[var(--gk-primary)]" onclick="sortTable('name')">
                        <div class="flex items-center gap-1">
                            {{ t("admin.plugin_name")|default:"Plugin Name" }}
                            <span class="sort-icon" data-column="name">
                                <svg class="h-4 w-4" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                                </svg>
                            </span>
                        </div>
                    </th>
                    <th scope="col" class="cursor-pointer hover:text-[var(--gk-primary)]" onclick="sortTable('version')">
                        <div class="flex items-center gap-1">
                            {{ t("admin.plugin_version")|default:"Version" }}
                            <span class="sort-icon" data-column="version">
                                <svg class="h-4 w-4" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                                </svg>
                            </span>
                        </div>
                    </th>
                    <th scope="col">{{ t("admin.plugin_runtime")|default:"Runtime" }}</th>
                    <th scope="col">{{ t("admin.plugin_routes")|default:"Routes" }}</th>
                    <th scope="col">{{ t("admin.plugin_widgets")|default:"Widgets" }}</th>
                    <th scope="col" class="cursor-pointer hover:text-[var(--gk-primary)]" onclick="sortTable('status')">
                        <div class="flex items-center gap-1">
                            {{ t("admin.plugin_status")|default:"Status" }}
                            <span class="sort-icon" data-column="status">
                                <svg class="h-4 w-4" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                                </svg>
                            </span>
                        </div>
                    </th>
                    <th scope="col">{{ t("admin.plugin_health")|default:"Health" }}</th>
                    <th scope="col" class="relative px-6 py-3">
                        <span class="sr-only">{{ t("admin.actions")|default:"Actions" }}</span>
                    </th>
                </tr>
            </thead>
            <tbody id="plugin-tbody">
                <tr>
                    <td colspan="8" class="px-6 py-12 text-center">
                        <div style="color: var(--gk-text-muted);">
                            <svg class="animate-spin mx-auto h-8 w-8 mb-2" style="color: var(--gk-primary);" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <p class="text-sm">{{ t("common.loading")|default:"Loading..." }}</p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Plugin Details Modal -->
<div id="plugin-details-modal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-plugin-name" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="gk-modal-backdrop fixed inset-0" aria-hidden="true" onclick="closePluginModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="gk-modal inline-block align-bottom text-left overflow-hidden transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full max-h-[90vh] overflow-y-auto">
            <div class="gk-modal-header">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full" style="background: var(--gk-primary-subtle);">
                        <svg class="h-6 w-6" style="color: var(--gk-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="ml-3 gk-modal-title" id="modal-plugin-name">{{ t("admin.plugin_details")|default:"Plugin Details" }}</h3>
                </div>
                <button type="button" class="gk-modal-close" onclick="closePluginModal()">
                    <svg class="icon-md" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="gk-modal-body" id="modal-plugin-content">
            </div>
            <div class="gk-modal-footer">
                <button type="button" class="gk-btn-secondary" onclick="closePluginModal()">{{ t("buttons.close")|default:"Close" }}</button>
            </div>
        </div>
    </div>
</div>

<!-- Upload Plugin Modal -->
<div id="upload-modal" class="hidden fixed z-10 inset-0 overflow-y-auto" aria-labelledby="upload-modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="gk-modal-backdrop fixed inset-0 transition-opacity" aria-hidden="true" onclick="closeUploadModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="gk-modal inline-block align-bottom text-left overflow-hidden transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="gk-modal-header">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full" style="background: var(--gk-primary-subtle);">
                        <svg class="h-6 w-6" style="color: var(--gk-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                        </svg>
                    </div>
                    <h3 class="ml-3 gk-modal-title" id="upload-modal-title">{{ t("admin.upload_plugin")|default:"Upload Plugin" }}</h3>
                </div>
                <button type="button" onclick="closeUploadModal()" class="gk-modal-close">
                    <svg class="icon-md" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="gk-modal-body space-y-4">
                <div>
                    <label for="plugin-file" class="form-label">
                        {{ t("admin.select_plugin_file")|default:"Select plugin file" }} <span style="color: var(--gk-error);">*</span>
                    </label>
                    <input type="file" id="plugin-file" accept=".wasm,.zip" class="gk-input-neon w-full" />
                    <p class="mt-1 text-xs" style="color: var(--gk-text-muted);">{{ t("admin.plugin_file_types")|default:"Supported: .wasm, .zip (plugin package)" }}</p>
                </div>
                <div>
                    <label for="plugin-signature" class="form-label">
                        {{ t("admin.plugin_signature_file")|default:"Signature (.wasm.sig)" }}
                    </label>
                    <input type="file" id="plugin-signature" accept=".sig" class="gk-input-neon w-full" />
                    <p class="mt-1 text-xs" style="color: var(--gk-text-muted);">{{ t("admin.plugin_signature_help")|default:"For a .wasm file. A .zip package carries its signature inside. Unsigned plugins are refused unless signatures are turned off (GOATFLOW_REQUIRE_SIGNATURES=0)." }}</p>
                </div>
                <div id="uploadError" class="hidden gk-alert gk-alert-error">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5" style="color: var(--gk-error);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <div class="text-sm" style="color: var(--gk-error);" id="uploadErrorMessage"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gk-modal-footer">
                <button type="button" onclick="closeUploadModal()" class="gk-btn-secondary">{{ t("buttons.cancel")|default:"Cancel" }}</button>
                <button type="button" id="upload-btn" onclick="uploadPlugin()" class="gk-btn-neon">
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                    </svg>
                    {{ t("buttons.upload")|default:"Upload" }}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed z-20 inset-0 overflow-y-auto" aria-labelledby="delete-modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="gk-modal-backdrop fixed inset-0 transition-opacity" aria-hidden="true" onclick="closeDeleteModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="gk-modal inline-block align-bottom text-left overflow-hidden transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="p-6">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full sm:mx-0 sm:h-10 sm:w-10" style="background: var(--gk-error-subtle);">
                        <svg class="h-6 w-6" style="color: var(--gk-error);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                        <h3 class="text-lg leading-6 font-medium" style="color: var(--gk-text-primary);" id="delete-modal-title">
                            {{ t("admin.delete_plugin")|default:"Delete Plugin" }}
                        </h3>
                        <div class="mt-2">
                            <p class="text-sm" style="color: var(--gk-text-muted);" id="delete-modal-message">
                                {{ t("admin.confirm_delete_plugin")|default:"Are you sure you want to delete this plugin?" }}
                            </p>
                            <p class="mt-2 text-sm" style="color: var(--gk-error);">
                                <svg class="inline h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                {{ t("admin.delete_plugin_warning")|default:"This action cannot be undone. All plugin routes and widgets will be removed." }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gk-modal-footer">
                <button type="button" onclick="closeDeleteModal()" class="gk-btn-secondary">{{ t("buttons.cancel")|default:"Cancel" }}</button>
                <button type="button" onclick="executeDelete()" class="gk-btn-danger" id="deleteConfirmBtn">
                    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    {{ t("admin.delete_plugin")|default:"Delete Plugin" }}
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Plugin Limits Modal -->
<div id="plugin-limits-i18n" class="hidden"
     data-load-failed="{{ t('admin.plugin_limits.load_failed')|default:'Could not load the plugin limits.' }}"
     data-stored="{{ t('admin.plugin_limits.stored_admin')|default:'Set by an administrator' }}"
     data-declared="{{ t('admin.plugin_limits.stored_declared')|default:'Declared by the plugin' }}"
     data-cgroup-on="{{ t('admin.plugin_limits.cgroup_enforced')|default:'Hard cgroup limits in force' }}"
     data-cgroup-off="{{ t('admin.plugin_limits.cgroup_not_enforced')|default:'Process limits only (no delegated cgroup)' }}"
     data-sandbox-full="{{ t('admin.plugin_limits.sandbox_full')|default:'Landlock: files, process memory and signals isolated' }}"
     data-sandbox-partial="{{ t('admin.plugin_limits.sandbox_partial')|default:'Landlock: files and process memory isolated. Upgrade the kernel to Linux {kernel} or later to isolate signals too.' }}"
     data-sandbox-off="{{ t('admin.plugin_limits.sandbox_off')|default:'Not enforced. Upgrade the kernel to Linux {kernel} or later, with Landlock enabled, to isolate files, process memory and signals.' }}"
     data-reset-confirm="{{ t('admin.plugin_limits.reset_confirm')|default:'Drop the administrator limits for this plugin and use what it declares?' }}"
     data-error="{{ t('common.error')|default:'Error' }}"></div>
<div id="plugin-limits-modal" class="hidden fixed z-30 inset-0 overflow-y-auto" aria-labelledby="limits-modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="gk-modal-backdrop fixed inset-0 transition-opacity" aria-hidden="true" onclick="closeLimitsModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="gk-modal inline-block align-bottom text-left overflow-hidden transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full max-h-[90vh] overflow-y-auto">
            <div class="gk-modal-header">
                <div class="flex items-center">
                    <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full" style="background: var(--gk-primary-subtle);">
                        <svg class="h-6 w-6" style="color: var(--gk-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="gk-modal-title" id="limits-modal-title">{{ t("admin.plugin_limits.title")|default:"Resource limits" }}</h3>
                        <p class="text-sm font-mono" style="color: var(--gk-text-secondary);" id="limits-modal-name"></p>
                    </div>
                </div>
                <button type="button" class="gk-modal-close" onclick="closeLimitsModal()" title="{{ t("buttons.close")|default:"Close" }}">
                    <svg class="icon-md" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <form id="limits-form" class="gk-modal-body space-y-4" onsubmit="saveLimits(); return false;" novalidate>
                <div class="grid grid-cols-2 gap-2 text-sm">
                    <div style="color: var(--gk-text-muted);">{{ t("admin.plugin_runtime")|default:"Runtime" }}</div>
                    <div><span class="gk-badge gk-badge-muted" id="limits-runtime">-</span></div>
                    <div style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.source")|default:"Limits" }}</div>
                    <div style="color: var(--gk-text-primary);" id="limits-source">-</div>
                    <div style="color: var(--gk-text-muted);" class="limits-cgroup hidden">{{ t("admin.plugin_limits.enforcement")|default:"Enforcement" }}</div>
                    <div style="color: var(--gk-text-primary);" class="limits-cgroup hidden" id="limits-cgroup">-</div>
                    <div style="color: var(--gk-text-muted);" class="limits-sandbox hidden">{{ t("admin.plugin_limits.sandbox")|default:"Sandbox" }}</div>
                    <div style="color: var(--gk-text-primary);" class="limits-sandbox hidden" id="limits-sandbox">-</div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div id="limit-wrap-memory_mb">
                        <label for="limit-memory_mb" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.memory")|default:"Memory (MB)" }}</label>
                        <input type="number" id="limit-memory_mb" name="memory_mb" min="16" max="65536" step="1" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.memory_help")|default:"Applies to gRPC and WASM plugins; gRPC plugins need at least 128 MB. Changing it reloads the plugin." }}</p>
                        <p class="mt-1 text-sm hidden" style="color: var(--gk-text-muted);" id="limit-na-memory_mb">{{ t("admin.plugin_limits.not_enforced")|default:"Not enforced for this runtime." }}</p>
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-memory_mb"></p>
                    </div>
                    <div id="limit-wrap-cpu_millis">
                        <label for="limit-cpu_millis" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.cpu")|default:"CPU (millicores)" }}</label>
                        <input type="number" id="limit-cpu_millis" name="cpu_millis" min="100" max="64000" step="100" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.cpu_help")|default:"gRPC plugins only. 1000 is one full core. Changing it reloads the plugin." }}</p>
                        <p class="mt-1 text-sm hidden" style="color: var(--gk-text-muted);" id="limit-na-cpu_millis">{{ t("admin.plugin_limits.not_enforced")|default:"Not enforced for this runtime." }}</p>
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-cpu_millis"></p>
                    </div>
                </div>

                <div id="limit-wrap-network">
                    <label class="inline-flex items-center gap-2 text-sm font-medium" style="color: var(--gk-text-secondary);">
                        <input type="checkbox" id="limit-network" name="network" class="h-4 w-4">
                        {{ t("admin.plugin_limits.network")|default:"Allow direct network access" }}
                    </label>
                    <p class="mt-1 text-sm" style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.network_help")|default:"gRPC plugins only. Without it the plugin process reaches the network only through the host API. Changing it reloads the plugin." }}</p>
                    <p class="mt-1 text-sm hidden" style="color: var(--gk-text-muted);" id="limit-na-network">{{ t("admin.plugin_limits.not_enforced")|default:"Not enforced for this runtime." }}</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="limit-call_timeout" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.call_timeout")|default:"Call timeout" }}</label>
                        <input type="text" id="limit-call_timeout" name="call_timeout" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-call_timeout"></p>
                    </div>
                    <div>
                        <label for="limit-init_timeout" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.init_timeout")|default:"Start-up timeout" }}</label>
                        <input type="text" id="limit-init_timeout" name="init_timeout" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-init_timeout"></p>
                    </div>
                </div>
                <p class="text-sm" style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.timeout_help")|default:"A duration from 1s to 24h, for example 30s, 5m or 1h. Takes effect without a reload." }}</p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label for="limit-max_calls_per_second" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.calls_per_second")|default:"Calls per second" }}</label>
                        <input type="number" id="limit-max_calls_per_second" name="max_calls_per_second" min="0" max="1000000" step="1" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-max_calls_per_second"></p>
                    </div>
                    <div>
                        <label for="limit-max_db_queries_per_min" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.db_queries_per_min")|default:"Database queries per minute" }}</label>
                        <input type="number" id="limit-max_db_queries_per_min" name="max_db_queries_per_min" min="0" max="1000000" step="1" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-max_db_queries_per_min"></p>
                    </div>
                    <div>
                        <label for="limit-max_http_req_per_min" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.http_req_per_min")|default:"Host HTTP requests per minute" }}</label>
                        <input type="number" id="limit-max_http_req_per_min" name="max_http_req_per_min" min="0" max="1000000" step="1" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-max_http_req_per_min"></p>
                    </div>
                </div>
                <p class="text-sm" style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.rate_help")|default:"0 means unlimited. Rates take effect without a reload." }}</p>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label for="limit-max_http_response_mb" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.http_response_mb")|default:"Host HTTP response size (MB)" }}</label>
                        <input type="number" id="limit-max_http_response_mb" name="max_http_response_mb" min="1" max="1024" step="1" class="gk-input-neon w-full">
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-max_http_response_mb"></p>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="limit-allowed_internal_hosts" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.internal_hosts")|default:"Allowed internal hosts" }}</label>
                        <textarea id="limit-allowed_internal_hosts" name="allowed_internal_hosts" rows="2" class="gk-input-neon w-full font-mono text-sm" placeholder="localhost"></textarea>
                        <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-allowed_internal_hosts"></p>
                    </div>
                </div>
                <p class="text-sm" style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.http_help")|default:"For requests the plugin makes through GoatFlow. A larger response than the size limit is refused; the plugin's memory must hold it. Internal hosts (localhost, private networks) are refused unless listed here or named exactly in the plugin's own http scope: one hostname or IP address per line, no port. Cloud metadata addresses are always refused. Takes effect without a reload." }}</p>

                <div>
                    <label for="limit-status" class="block text-sm font-medium mb-1" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_limits.status")|default:"Review status" }}</label>
                    <select id="limit-status" name="status" class="gk-select-neon w-full">
                        <option value="pending_review">{{ t("admin.plugin_limits.status_pending_review")|default:"Pending review" }}</option>
                        <option value="approved">{{ t("admin.plugin_limits.status_approved")|default:"Approved" }}</option>
                        <option value="restricted">{{ t("admin.plugin_limits.status_restricted")|default:"Restricted" }}</option>
                        <option value="blocked">{{ t("admin.plugin_limits.status_blocked")|default:"Blocked" }}</option>
                    </select>
                    <p class="mt-1 text-sm hidden limit-error" style="color: var(--gk-error);" id="limit-error-status"></p>
                </div>

                <div id="limits-usage" class="hidden">
                    <div class="text-sm font-semibold mb-2" style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.usage")|default:"Usage since start" }}</div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm">
                        <div style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.usage_calls")|default:"Calls" }}: <span style="color: var(--gk-text-primary);" id="limits-usage-calls">0</span></div>
                        <div style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.usage_errors")|default:"Errors" }}: <span style="color: var(--gk-text-primary);" id="limits-usage-errors">0</span></div>
                        <div style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.usage_db")|default:"Database queries" }}: <span style="color: var(--gk-text-primary);" id="limits-usage-db">0</span></div>
                        <div style="color: var(--gk-text-muted);">{{ t("admin.plugin_limits.usage_http")|default:"HTTP requests" }}: <span style="color: var(--gk-text-primary);" id="limits-usage-http">0</span></div>
                    </div>
                </div>

                <div id="limits-message" class="hidden gk-alert">
                    <div class="text-sm" id="limits-message-text"></div>
                </div>
            </form>
            <div class="gk-modal-footer">
                <button type="button" onclick="resetLimits()" class="gk-btn-secondary" id="limits-reset-btn">{{ t("admin.plugin_limits.reset")|default:"Reset to declared" }}</button>
                <button type="button" onclick="closeLimitsModal()" class="gk-btn-secondary">{{ t("buttons.close")|default:"Close" }}</button>
                <button type="button" onclick="saveLimits()" class="gk-btn-neon" id="limits-save-btn">{{ t("admin.plugin_limits.save")|default:"Save limits" }}</button>
            </div>
        </div>
    </div>
</div>

<script>
let plugins = [];
let sortColumn = 'name';
let sortOrder = 'asc';

const i18n = {
    selectFile: "{{ t('admin.please_select_file')|default:'Please select a file' }}",
    failedToPlugin: "{{ t('admin.failed_to_plugin')|default:'Failed to {action} plugin' }}",
    uploadFailed: "{{ t('admin.upload_failed')|default:'Upload failed' }}",
    noPlugins: "{{ t('admin.no_plugins')|default:'No plugins installed' }}",
    viewDetails: "{{ t('admin.view_details')|default:'View Details' }}",
    disable: "{{ t('buttons.disable')|default:'Disable' }}",
    enable: "{{ t('buttons.enable')|default:'Enable' }}",
    deletePlugin: "{{ t('admin.delete_plugin')|default:'Delete' }}",
    error: "{{ t('common.error')|default:'Error' }}",
    confirmDeletePlugin: "{{ t('admin.confirm_delete_plugin')|default:'Are you sure you want to delete the plugin \"{name}\"?' }}",
    appModeOn: "{{ t('admin.plugin_app_mode_on')|default:'App mode on' }}",
    appModeOff: "{{ t('admin.plugin_app_mode_off')|default:'App mode off' }}",
    appModeTurnOn: "{{ t('admin.plugin_app_mode_turn_on')|default:'Turn on' }}",
    appModeTurnOff: "{{ t('admin.plugin_app_mode_turn_off')|default:'Turn off' }}",
    appModeAllAgents: "{{ t('admin.plugin_app_mode_all_agents')|default:'All agents' }}",
    appModeOtherPlugins: "{{ t('admin.plugin_app_mode_other_plugins')|default:'menus of other plugins' }}",
    limits: "{{ t('admin.plugin_limits.action')|default:'Limits' }}"
};

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Sort icons
const SORT_NEUTRAL = `<svg class="h-4 w-4" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" /></svg>`;
const SORT_ASC = `<svg class="h-4 w-4" style="color: var(--gk-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>`;
const SORT_DESC = `<svg class="h-4 w-4" style="color: var(--gk-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>`;

function updateSortIcons() {
    document.querySelectorAll('.sort-icon').forEach(icon => {
        const col = icon.dataset.column;
        if (col === sortColumn) {
            icon.innerHTML = sortOrder === 'asc' ? SORT_ASC : SORT_DESC;
        } else {
            icon.innerHTML = SORT_NEUTRAL;
        }
    });
}

function sortTable(column) {
    if (sortColumn === column) {
        sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
    } else {
        sortColumn = column;
        sortOrder = 'asc';
    }
    updateSortIcons();
    filterAndRender();
}

// Search and filter
let searchTimer;
function handleSearchInput() {
    clearTimeout(searchTimer);
    const val = document.getElementById('pluginSearch').value;
    document.getElementById('clearSearchBtn').style.display = val ? 'block' : 'none';
    searchTimer = setTimeout(() => filterAndRender(), 300);
}

function clearSearch() {
    document.getElementById('pluginSearch').value = '';
    document.getElementById('clearSearchBtn').style.display = 'none';
    filterAndRender();
}

function clearFilters() {
    document.getElementById('pluginSearch').value = '';
    document.getElementById('statusFilter').value = '';
    document.getElementById('clearSearchBtn').style.display = 'none';
    filterAndRender();
}

function getFilteredPlugins() {
    const search = (document.getElementById('pluginSearch').value || '').toLowerCase();
    const status = document.getElementById('statusFilter').value;

    let filtered = plugins.filter(p => {
        if (search && !p.name.toLowerCase().includes(search) && !(p.description || '').toLowerCase().includes(search)) {
            return false;
        }
        if (status === 'enabled' && !p.enabled) return false;
        if (status === 'disabled' && p.enabled) return false;
        return true;
    });

    // Sort
    filtered.sort((a, b) => {
        let va, vb;
        switch (sortColumn) {
            case 'name':
                va = a.name.toLowerCase();
                vb = b.name.toLowerCase();
                break;
            case 'version':
                va = a.version || '';
                vb = b.version || '';
                break;
            case 'status':
                va = a.enabled ? 1 : 0;
                vb = b.enabled ? 1 : 0;
                break;
            default:
                va = a.name.toLowerCase();
                vb = b.name.toLowerCase();
        }
        if (va < vb) return sortOrder === 'asc' ? -1 : 1;
        if (va > vb) return sortOrder === 'asc' ? 1 : -1;
        return 0;
    });

    return filtered;
}

function renderHealthCell(plugin) {
    const h = plugin.health;
    if (!h) {
        return `<span class="gk-badge gk-badge-muted" title="{{ t("admin.health_unknown_tooltip")|default:"No health data yet" }}">{{ t("admin.health_unknown")|default:"-" }}</span>`;
    }
    if (h.crash_loop_abandoned) {
        return `
            <div class="flex items-center gap-2">
                <span class="gk-badge gk-badge-error" title="${escapeHtml(h.last_error || '')}">{{ t("admin.health_abandoned")|default:"Crash-loop" }}</span>
                <button type="button"
                        onclick="resetCrashLoop('${escapeHtml(plugin.name)}')"
                        title="{{ t("admin.reset_crashloop_tooltip")|default:"Clear the crash-loop guard and resume auto-recovery" }}"
                        class="text-xs underline" style="color: var(--gk-primary);">
                    {{ t("buttons.reset")|default:"Reset" }}
                </button>
            </div>`;
    }
    if (!h.healthy && h.consecutive_failures >= 3) {
        const attempts = h.restart_attempts || 0;
        const sub = attempts > 0
            ? `<div class="text-xs" style="color: var(--gk-text-muted);">{{ t("admin.health_restart_attempt")|default:"Restart attempt" }} ${attempts}</div>`
            : '';
        return `
            <div>
                <span class="gk-badge gk-badge-error" title="${escapeHtml(h.last_error || '')}">{{ t("admin.health_unhealthy")|default:"Unhealthy" }}</span>
                ${sub}
            </div>`;
    }
    if (h.healthy) {
        return `<span class="gk-badge gk-badge-success">{{ t("admin.health_healthy")|default:"Healthy" }}</span>`;
    }
    // Pending first probe — neither failed nor confirmed.
    return `<span class="gk-badge gk-badge-muted">{{ t("admin.health_pending")|default:"Pending" }}</span>`;
}

function renderPluginRow(plugin) {
    const routeCount = plugin.routes ? plugin.routes.length : 0;
    const widgetCount = plugin.widgets ? plugin.widgets.length : 0;
    const enabled = plugin.enabled;
    const runtime = escapeHtml(plugin.runtime || plugin.type || 'unknown');

    return `
        <tr id="plugin-row-${escapeHtml(plugin.name)}">
            <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                    ${plugin.icon
                        ? `<img src="${escapeHtml(plugin.icon)}" alt="" class="h-6 w-6 rounded flex-shrink-0" loading="lazy" onerror="this.style.display='none'">`
                        : `<div class="h-6 w-6 rounded flex-shrink-0 flex items-center justify-center text-xs font-bold" style="background: var(--gk-bg-elevated); color: var(--gk-text-muted);">${(plugin.name || '?')[0].toUpperCase()}</div>`}
                    <div>
                        <div class="text-sm font-medium" style="color: var(--gk-text-primary);">
                            <a href="#" onclick="showPluginDetails('${escapeHtml(plugin.name)}'); return false;" class="hover:underline" style="color: var(--gk-primary);">
                                ${escapeHtml(plugin.name)}
                            </a>
                        </div>
                        <div class="text-sm max-w-xs truncate" style="color: var(--gk-text-muted);" title="${escapeHtml(plugin.description || '')}">
                            ${escapeHtml((plugin.description || '').substring(0, 80)) || '-'}
                        </div>
                    </div>
                </div>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
                <span class="text-sm" style="color: var(--gk-text-muted);">${escapeHtml(plugin.version || '1.0.0')}</span>
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
                <span class="gk-badge gk-badge-muted">${runtime}</span>
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm" style="color: var(--gk-text-muted);">
                ${routeCount > 0 ? routeCount : '-'}
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-sm" style="color: var(--gk-text-muted);">
                ${widgetCount > 0 ? widgetCount : '-'}
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
                ${enabled
                    ? '<span class="gk-badge gk-badge-success">Enabled</span>'
                    : '<span class="gk-badge gk-badge-muted">Disabled</span>'}
            </td>
            <td class="px-4 py-3 whitespace-nowrap">
                ${renderHealthCell(plugin)}
            </td>
            <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex items-center justify-end space-x-2">
                    ${enabled
                        ? `<button
                                onclick="togglePlugin('${escapeHtml(plugin.name)}', false)"
                                title="${i18n.disable}"
                                class="p-2 rounded-lg transition-all duration-200 hover:bg-[var(--gk-warning-subtle)]"
                                style="color: var(--gk-warning);"
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                </svg>
                            </button>`
                        : `<button
                                onclick="togglePlugin('${escapeHtml(plugin.name)}', true)"
                                title="${i18n.enable}"
                                class="p-2 rounded-lg transition-all duration-200 hover:bg-[var(--gk-success-subtle)]"
                                style="color: var(--gk-success);"
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            </button>`}
                    ${plugin.loaded
                        ? `<button
                                onclick="showLimitsModal('${escapeHtml(plugin.name)}')"
                                title="${i18n.limits}"
                                class="p-2 rounded-lg transition-all duration-200 hover:bg-[var(--gk-primary-subtle)]"
                                style="color: var(--gk-primary);"
                            >
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                                </svg>
                            </button>`
                        : ''}
                    <button
                        onclick="confirmDeletePlugin('${escapeHtml(plugin.name)}')"
                        title="${i18n.deletePlugin}"
                        class="p-2 rounded-lg transition-all duration-200 hover:bg-[var(--gk-error-subtle)]"
                        style="color: var(--gk-error);"
                    >
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </div>
            </td>
        </tr>`;
}

function filterAndRender() {
    const filtered = getFilteredPlugins();
    const tbody = document.getElementById('plugin-tbody');

    if (filtered.length > 0) {
        tbody.innerHTML = filtered.map(renderPluginRow).join('');
    } else {
        tbody.innerHTML = `
            <tr>
                <td colspan="8" class="px-6 py-12 text-center">
                    <div style="color: var(--gk-text-muted);">
                        <svg class="mx-auto h-12 w-12" style="color: var(--gk-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        <p class="mt-2 text-sm">${plugins.length === 0 ? i18n.noPlugins : '{{ t("admin.no_plugins_match")|default:"No plugins match your filters" }}'}</p>
                    </div>
                </td>
            </tr>`;
    }
}

async function loadPlugins() {
    try {
        // Fetch plugin list and per-plugin health in parallel — health is
        // best-effort: if the endpoint fails (e.g. checker disabled) the
        // table still renders without the Health column populated.
        const [listResp, healthResp] = await Promise.all([
            fetch('/api/v1/plugins', { credentials: 'same-origin' }),
            fetch('/api/v1/plugins/health', { credentials: 'same-origin' }).catch(() => null),
        ]);
        const data = await listResp.json();
        plugins = data.plugins || [];

        let healthMap = {};
        if (healthResp && healthResp.ok) {
            const hData = await healthResp.json();
            healthMap = hData.plugins || {};
        }
        plugins.forEach(p => { p.health = healthMap[p.name] || null; });

        // Update stats
        const enabled = plugins.filter(p => p.enabled).length;
        const disabled = plugins.length - enabled;
        const healthy = plugins.filter(p => p.health && p.health.healthy).length;
        const unhealthy = plugins.filter(p => p.health && (!p.health.healthy && p.health.consecutive_failures >= 3)).length;
        document.getElementById('stat-total').textContent = plugins.length;
        document.getElementById('stat-enabled').textContent = enabled;
        document.getElementById('stat-disabled').textContent = disabled;
        document.getElementById('stat-healthy').textContent = healthy;
        document.getElementById('stat-unhealthy').textContent = unhealthy;

        filterAndRender();
    } catch (err) {
        console.error('Failed to load plugins:', err);
    }
}

async function resetCrashLoop(name) {
    if (!confirm('{{ t("admin.reset_crashloop_confirm")|default:"Clear the crash-loop guard for this plugin? Auto-recovery will resume on the next health check." }}')) {
        return;
    }
    try {
        const response = await fetch(`/api/v1/plugins/${name}/reset-crashloop`, {
            method: 'POST',
            credentials: 'same-origin',
        });
        if (response.ok) {
            loadPlugins();
        } else {
            const err = await response.json().catch(() => ({}));
            alert(err.error || 'Failed to reset crash-loop guard');
        }
    } catch (err) {
        alert('Network error: ' + err.message);
    }
}
function showPluginDetails(name) {
    const plugin = plugins.find(p => p.name === name);
    if (!plugin) return;

    const modal = document.getElementById('plugin-details-modal');
    document.getElementById('modal-plugin-name').textContent = plugin.name;

    // Plugin icon
    const iconHtml = plugin.icon
        ? `<img src="${escapeHtml(plugin.icon)}" alt="" class="h-10 w-10 rounded flex-shrink-0" loading="lazy" onerror="this.style.display='none'">`
        : `<div class="h-10 w-10 rounded flex-shrink-0 flex items-center justify-center text-xs font-bold" style="background: var(--gk-bg-elevated); color: var(--gk-text-muted);">${(plugin.name || '?')[0].toUpperCase()}</div>`;

    const muted = 'color: var(--gk-text-muted)';
    let html = `
        <div class="space-y-4">
            <div class="flex items-center gap-4 mb-4">
                ${iconHtml}
                <div>
                    <div class="text-lg font-semibold" style="color: var(--gk-text-primary);">${escapeHtml(plugin.name)}</div>
                    <div class="text-sm" style="color: var(--gk-text-secondary);">{{ t("admin.plugin_overview")|default:"Plugin Overview" }}</div>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2 text-sm">
                <div style="${muted}">{{ t("admin.plugin_version")|default:"Version" }}</div>
                <div><span class="gk-badge gk-badge-muted">${escapeHtml(plugin.version || '1.0.0')}</span></div>
                <div style="${muted}">{{ t("admin.plugin_author")|default:"Author" }}</div>
                <div class="font-medium" style="color: var(--gk-text-primary);">${escapeHtml(plugin.author || 'Unknown')}</div>
                <div style="${muted}">{{ t("admin.plugin_runtime")|default:"Runtime" }}</div>
                <div><span class="gk-badge gk-badge-accent">${escapeHtml(plugin.runtime || plugin.type || 'unknown')}</span></div>
                <div style="${muted}">{{ t("admin.plugin_license")|default:"License" }}</div>
                <div style="color: var(--gk-text-primary);">${escapeHtml(plugin.license || 'Not specified')}</div>
            </div>
            <div class="gk-divider"></div>
            <div>
                <div class="text-sm font-semibold mb-1" style="${muted}">{{ t("admin.plugin_description")|default:"Description" }}</div>
                <p class="text-sm" style="color: var(--gk-text-primary);">${escapeHtml(plugin.description || 'No description')}</p>
            </div>`;

    if (plugin.routes && plugin.routes.length > 0) {
        html += `
            <div class="gk-divider"></div>
            <div>
                <div class="text-sm font-semibold mb-2" style="${muted}">{{ t("admin.plugin_routes")|default:"Routes" }}</div>
                <ul class="space-y-1">
                    ${plugin.routes.map(r => `<li class="text-sm flex items-start gap-2"><span class="gk-badge gk-badge-primary font-mono">${escapeHtml(r.method)}</span><code class="gk-link-neon">${escapeHtml(r.path)}</code><span style="${muted}">- ${escapeHtml(r.description || r.handler)}</span></li>`).join('')}
                </ul>
            </div>`;
    }

    if (plugin.widgets && plugin.widgets.length > 0) {
        html += `
            <div class="gk-divider"></div>
            <div>
                <div class="text-sm font-semibold mb-2" style="${muted}">{{ t("admin.plugin_widgets")|default:"Widgets" }}</div>
                <ul class="space-y-1">
                    ${plugin.widgets.map(w => `<li class="text-sm flex items-center gap-2"><span class="gk-badge gk-badge-secondary">${escapeHtml(w.location)}</span><span style="color: var(--gk-text-primary);">${escapeHtml(w.title || w.id)}</span></li>`).join('')}
                </ul>
            </div>`;
    }

    if (plugin.jobs && plugin.jobs.length > 0) {
        html += `
            <div class="gk-divider"></div>
            <div>
                <div class="text-sm font-semibold mb-2" style="${muted}">{{ t("admin.plugin_jobs")|default:"Scheduled Jobs" }}</div>
                <ul class="space-y-1">
                    ${plugin.jobs.map(j => `<li class="text-sm flex items-center gap-2"><span class="gk-badge gk-badge-muted font-mono">${escapeHtml(j.schedule)}</span><span style="color: var(--gk-text-primary);">${escapeHtml(j.description || j.id)}</span></li>`).join('')}
                </ul>
            </div>`;
    }

    if (plugin.app_mode) {
        const am = plugin.app_mode;
        const badge = (text) => `<span class="gk-badge gk-badge-muted font-mono">${escapeHtml(text)}</span>`;
        const groups = (am.groups && am.groups.length) ? am.groups.map(badge).join(' ') : i18n.appModeAllAgents;
        let hidden = (am.hide_menu_items || []).map(badge).join(' ');
        if (am.hide_plugin_menus) {
            hidden += ' ' + badge(i18n.appModeOtherPlugins);
        }
        html += `
            <div class="gk-divider"></div>
            <div>
                <div class="text-sm font-semibold mb-2" style="${muted}">{{ t("admin.plugin_app_mode")|default:"App mode" }}</div>
                <p class="text-sm mb-2" style="color: var(--gk-text-primary);">{{ t("admin.plugin_app_mode_help")|default:"Agents in these groups see GoatFlow as this plugin's application: they land on its page after login and the listed menu items are hidden. Administrators always keep the full helpdesk." }}</p>
                <div class="grid grid-cols-2 gap-2 text-sm">
                    <div style="${muted}">{{ t("admin.plugin_app_mode_groups")|default:"Groups" }}</div>
                    <div>${groups}</div>
                    <div style="${muted}">{{ t("admin.plugin_app_mode_landing")|default:"Landing page" }}</div>
                    <div><code class="gk-link-neon">${escapeHtml(am.landing_page || '/dashboard')}</code></div>
                    <div style="${muted}">{{ t("admin.plugin_app_mode_hidden")|default:"Hidden menu items" }}</div>
                    <div>${hidden.trim() || '-'}</div>
                </div>
                <div class="mt-3 flex items-center gap-3">
                    ${am.enabled
                        ? `<span class="gk-badge gk-badge-success">${i18n.appModeOn}</span>`
                        : `<span class="gk-badge gk-badge-muted">${i18n.appModeOff}</span>`}
                    <button type="button" class="gk-btn-secondary text-sm" onclick="toggleAppMode('${escapeHtml(plugin.name)}', ${am.enabled ? 'false' : 'true'})">
                        ${am.enabled ? i18n.appModeTurnOff : i18n.appModeTurnOn}
                    </button>
                </div>
            </div>`;
    }

    html += '</div>';
    document.getElementById('modal-plugin-content').innerHTML = html;
    modal.classList.remove('hidden');
}

function closePluginModal() {
    document.getElementById('plugin-details-modal').classList.add('hidden');
}

// Resource limits
let limitsPlugin = null;
const LIMIT_FIELDS = ['memory_mb', 'cpu_millis', 'call_timeout', 'init_timeout', 'max_calls_per_second', 'max_db_queries_per_min', 'max_http_req_per_min', 'max_http_response_mb', 'status'];
const LIMIT_NUMBER_FIELDS = ['memory_mb', 'cpu_millis', 'max_calls_per_second', 'max_db_queries_per_min', 'max_http_req_per_min', 'max_http_response_mb'];

function limitsText(key) {
    return document.getElementById('plugin-limits-i18n').dataset[key] || '';
}

function limitInput(field) {
    return document.getElementById('limit-' + field);
}

function setLimitsMessage(type, text) {
    const box = document.getElementById('limits-message');
    box.classList.remove('gk-alert-success', 'gk-alert-error', 'gk-alert-warning');
    if (!text) {
        box.classList.add('hidden');
        return;
    }
    box.classList.add('gk-alert-' + type);
    document.getElementById('limits-message-text').textContent = text;
    box.classList.remove('hidden');
}

function clearLimitsErrors() {
    document.querySelectorAll('#limits-form .limit-error').forEach(el => {
        el.textContent = '';
        el.classList.add('hidden');
    });
}

function setLimitEnforced(field, enforced) {
    limitInput(field).disabled = !enforced;
    document.getElementById('limit-wrap-' + field).style.opacity = enforced ? '1' : '0.5';
    document.getElementById('limit-na-' + field).classList.toggle('hidden', !!enforced);
}

function fillLimitsForm(data) {
    const p = data.policy || {};
    const launch = data.launch || {};
    const enforced = data.enforced || {};
    limitInput('memory_mb').value = launch.memory_mb;
    limitInput('cpu_millis').value = launch.cpu_millis;
    limitInput('network').checked = !!launch.network;
    limitInput('call_timeout').value = p.call_timeout || '';
    limitInput('init_timeout').value = p.init_timeout || '';
    limitInput('max_calls_per_second').value = p.max_calls_per_second || 0;
    limitInput('max_db_queries_per_min').value = p.max_db_queries_per_min || 0;
    limitInput('max_http_req_per_min').value = p.max_http_req_per_min || 0;
    limitInput('max_http_response_mb').value = p.max_http_response_mb || data.default_http_response_mb || 32;
    limitInput('allowed_internal_hosts').value = (p.allowed_internal_hosts || []).join('\n');
    limitInput('status').value = p.status || 'pending_review';
    setLimitEnforced('memory_mb', enforced.memory);
    setLimitEnforced('cpu_millis', enforced.cpu);
    setLimitEnforced('network', enforced.network);
    limitInput('memory_mb').min = data.runtime === 'grpc' ? 128 : 16;

    document.getElementById('limits-runtime').textContent = data.runtime || '-';
    document.getElementById('limits-source').textContent = data.stored ? limitsText('stored') : limitsText('declared');
    document.getElementById('limits-reset-btn').disabled = !data.stored;

    const hasCgroup = typeof data.cgroup_enforced === 'boolean';
    document.querySelectorAll('.limits-cgroup').forEach(el => el.classList.toggle('hidden', !hasCgroup));
    if (hasCgroup) {
        document.getElementById('limits-cgroup').textContent = data.cgroup_enforced ? limitsText('cgroupOn') : limitsText('cgroupOff');
    }

    const sandbox = data.sandbox;
    document.querySelectorAll('.limits-sandbox').forEach(el => el.classList.toggle('hidden', !sandbox));
    if (sandbox) {
        const key = sandbox.signals ? 'sandboxFull' : (sandbox.files ? 'sandboxPartial' : 'sandboxOff');
        document.getElementById('limits-sandbox').textContent = limitsText(key).replace('{kernel}', sandbox.full_kernel);
    }

    const usage = data.usage;
    document.getElementById('limits-usage').classList.toggle('hidden', !usage);
    if (usage) {
        document.getElementById('limits-usage-calls').textContent = usage.calls;
        document.getElementById('limits-usage-errors').textContent = usage.errors;
        document.getElementById('limits-usage-db').textContent = usage.db_queries;
        document.getElementById('limits-usage-http').textContent = usage.http_requests;
    }
}

async function showLimitsModal(name) {
    limitsPlugin = name;
    clearLimitsErrors();
    setLimitsMessage('', '');
    document.getElementById('limits-form').reset();
    document.getElementById('limits-modal-name').textContent = name;
    document.getElementById('plugin-limits-modal').classList.remove('hidden');
    try {
        const response = await fetch(`/api/v1/plugins/${encodeURIComponent(name)}/policy`, { credentials: 'same-origin' });
        const data = await response.json();
        if (!response.ok) {
            setLimitsMessage('error', data.error || limitsText('loadFailed'));
            return;
        }
        fillLimitsForm(data);
    } catch (err) {
        setLimitsMessage('error', `${limitsText('error')}: ${err.message}`);
    }
}

function closeLimitsModal() {
    document.getElementById('plugin-limits-modal').classList.add('hidden');
    limitsPlugin = null;
}

function showLimitsResult(response, data) {
    if (response.ok) {
        fillLimitsForm(data);
        setLimitsMessage(data.reload_error ? 'warning' : 'success', data.message || '');
        loadPlugins();
        return;
    }
    const fields = data.fields || {};
    Object.keys(fields).forEach(field => {
        const el = document.getElementById('limit-error-' + field);
        if (el) {
            el.textContent = fields[field];
            el.classList.remove('hidden');
        }
    });
    setLimitsMessage('error', data.error || limitsText('error'));
}

async function saveLimits() {
    if (!limitsPlugin) return;
    clearLimitsErrors();
    const body = {};
    LIMIT_FIELDS.forEach(field => {
        const input = limitInput(field);
        if (input.disabled) return;
        body[field] = LIMIT_NUMBER_FIELDS.includes(field) ? Number(input.value) : input.value.trim();
    });
    if (!limitInput('network').disabled) {
        body.network = limitInput('network').checked;
    }
    body.allowed_internal_hosts = limitInput('allowed_internal_hosts').value.split(/[\s,]+/).filter(Boolean);
    const btn = document.getElementById('limits-save-btn');
    btn.disabled = true;
    try {
        const response = await fetch(`/api/v1/plugins/${encodeURIComponent(limitsPlugin)}/policy`, {
            method: 'PUT',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        showLimitsResult(response, await response.json());
    } catch (err) {
        setLimitsMessage('error', `${limitsText('error')}: ${err.message}`);
    } finally {
        btn.disabled = false;
    }
}

async function resetLimits() {
    if (!limitsPlugin || !confirm(limitsText('resetConfirm'))) return;
    clearLimitsErrors();
    try {
        const response = await fetch(`/api/v1/plugins/${encodeURIComponent(limitsPlugin)}/policy`, {
            method: 'DELETE',
            credentials: 'same-origin'
        });
        showLimitsResult(response, await response.json());
    } catch (err) {
        setLimitsMessage('error', `${limitsText('error')}: ${err.message}`);
    }
}

async function togglePlugin(name, enable) {
    const action = enable ? 'enable' : 'disable';
    try {
        const response = await fetch(`/api/v1/plugins/${name}/${action}`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' }
        });
        if (response.ok) {
            loadPlugins();
            showToast('success', `Plugin "${name}" ${action}d successfully.`);
        } else {
            const data = await response.json();
            showToast('error', data.error || i18n.failedToPlugin.replace('{action}', action));
        }
    } catch (err) {
        showToast('error', `${i18n.error}: ${err.message}`);
    }
}

async function toggleAppMode(name, enable) {
    try {
        const response = await fetch(`/api/v1/plugins/${name}/app-mode`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: enable })
        });
        const data = await response.json();
        if (response.ok) {
            await loadPlugins();
            showPluginDetails(name);
            showToast('success', enable ? i18n.appModeOn : i18n.appModeOff);
        } else {
            showToast('error', data.error || i18n.failedToPlugin.replace('{action}', 'update'));
        }
    } catch (err) {
        showToast('error', `${i18n.error}: ${err.message}`);
    }
}

// Upload modal
function showUploadModal() {
    document.getElementById('uploadError').classList.add('hidden');
    document.getElementById('plugin-file').value = '';
    document.getElementById('upload-modal').classList.remove('hidden');
}

function closeUploadModal() {
    document.getElementById('upload-modal').classList.add('hidden');
}

async function uploadPlugin() {
    const fileInput = document.getElementById('plugin-file');
    const file = fileInput.files[0];
    if (!file) {
        document.getElementById('uploadErrorMessage').textContent = i18n.selectFile;
        document.getElementById('uploadError').classList.remove('hidden');
        return;
    }

    const formData = new FormData();
    formData.append('plugin', file);
    const sig = document.getElementById('plugin-signature').files[0];
    if (sig) {
        formData.append('signature', sig);
    }

    const uploadBtn = document.getElementById('upload-btn');
    const originalHTML = uploadBtn.innerHTML;
    uploadBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        {{ t("admin.uploading")|default:"Uploading..." }}
    `;
    uploadBtn.disabled = true;

    try {
        const response = await fetch('/api/v1/plugins/upload', {
            method: 'POST',
            credentials: 'same-origin',
            body: formData
        });
        const data = await response.json();
        if (response.ok) {
            closeUploadModal();
            loadPlugins();
            showToast('success', `Plugin uploaded successfully.`);
        } else {
            document.getElementById('uploadErrorMessage').textContent = data.error || i18n.uploadFailed;
            document.getElementById('uploadError').classList.remove('hidden');
        }
    } catch (err) {
        document.getElementById('uploadErrorMessage').textContent = `${i18n.error}: ${err.message}`;
        document.getElementById('uploadError').classList.remove('hidden');
    } finally {
        uploadBtn.innerHTML = originalHTML;
        uploadBtn.disabled = false;
    }
}

// Delete
let pluginToDelete = null;

function confirmDeletePlugin(name) {
    pluginToDelete = name;
    document.getElementById('delete-modal-message').textContent =
        i18n.confirmDeletePlugin.replace('{name}', name);
    document.getElementById('deleteModal').classList.remove('hidden');
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    pluginToDelete = null;
}

async function executeDelete() {
    if (!pluginToDelete) return;
    const name = pluginToDelete;

    const btn = document.getElementById('deleteConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        {{ t("admin.deleting")|default:"Deleting..." }}
    `;

    try {
        const response = await fetch(`/api/v1/plugins/${name}`, {
            method: 'DELETE',
            credentials: 'same-origin'
        });
        if (response.ok) {
            closeDeleteModal();
            loadPlugins();
            showToast('success', `Plugin "${name}" deleted successfully.`);
        } else {
            const data = await response.json();
            showToast('error', data.error || 'Failed to delete plugin');
            closeDeleteModal();
        }
    } catch (err) {
        showToast('error', `${i18n.error}: ${err.message}`);
        closeDeleteModal();
    }
}

// Toast (same pattern as groups page)
function showToast(type, message) {
    const container = document.getElementById('toast-container') || createToastContainer();
    const toast = document.createElement('div');
    toast.className = 'transform transition-all duration-300 translate-x-0 max-w-sm w-full shadow-lg rounded-lg pointer-events-auto overflow-hidden';
    toast.style.background = 'var(--gk-bg-elevated)';
    toast.style.border = '1px solid var(--gk-border-default)';

    const iconColor = type === 'success' ? 'var(--gk-success)' : 'var(--gk-error)';
    const bgColor = type === 'success' ? 'var(--gk-success-subtle)' : 'var(--gk-error-subtle)';
    const icon = type === 'success'
        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />'
        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';

    toast.innerHTML = `
        <div class="p-4" style="background: ${bgColor};">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <svg class="h-6 w-6" style="color: ${iconColor};" fill="none" stroke="currentColor" viewBox="0 0 24 24">${icon}</svg>
                </div>
                <div class="ml-3 w-0 flex-1 pt-0.5">
                    <p class="text-sm font-medium" style="color: ${iconColor};">${message}</p>
                </div>
            </div>
        </div>
    `;
    container.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '1'; }, 100);
    setTimeout(() => {
        toast.style.transform = 'translateX(100%)';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

function createToastContainer() {
    const c = document.createElement('div');
    c.id = 'toast-container';
    c.className = 'fixed bottom-0 right-0 p-6 space-y-4 z-50';
    document.body.appendChild(c);
    return c;
}

// Initial load
loadPlugins();
updateSortIcons();

// Auto-refresh every 10s
setInterval(loadPlugins, 10000);
</script>
{% endblock %}
