{% extends "layouts/base.pongo2" %}

{% block title %}{{ Task.Title|default:"Setup Task" }} - GoatFlow Admin{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-2xl">
    <header class="mb-6">
        <a href="/admin/setup/assistant" class="gk-btn-secondary mb-3 inline-flex items-center">
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Back to Setup Assistant
        </a>
        <h1 class="text-2xl font-bold gk-heading"><span class="gk-text-gradient">{{ Task.Title|default:"Setup Task" }}</span></h1>
        {% if Task.Description %}<p class="mt-2 text-sm" style="color: var(--gk-text-secondary);">{{ Task.Description }}</p>{% endif %}
    </header>

    <div id="taskMsg" class="text-sm mb-3" style="color: var(--gk-danger, #ef4444);"></div>

    <form id="taskForm" class="gk-card-glow rounded-lg p-6 space-y-4" onsubmit="submitTask(event)">
        {% if IsMarkComplete %}
            <p class="text-sm" style="color: var(--gk-text-secondary);">Mark first-run setup complete. The admin dashboard will stop redirecting to the wizard.</p>
        {% else %}
            {% if Task.ID == "create_group" %}
                <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Team name *</label>
                     <input type="text" name="name" required class="gk-input-neon w-full"></div>
                <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Comments</label>
                     <input type="text" name="comments" class="gk-input-neon w-full"></div>
            {% elif Task.ID == "create_queue" %}
                <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Queue name *</label>
                     <input type="text" name="name" required class="gk-input-neon w-full"></div>
                <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Comments</label>
                     <input type="text" name="comments" class="gk-input-neon w-full"></div>
                {% include "pages/admin/_setup_group_checkboxes.pongo2" %}
            {% elif Task.ID == "create_agent" %}
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Login *</label><input type="text" name="login" required class="gk-input-neon w-full"></div>
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Email</label><input type="email" name="email" class="gk-input-neon w-full"></div>
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">First name</label><input type="text" name="first_name" class="gk-input-neon w-full"></div>
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Last name</label><input type="text" name="last_name" class="gk-input-neon w-full"></div>
                </div>
                {% include "pages/admin/_setup_group_checkboxes.pongo2" %}
            {% elif Task.ID == "create_customer" %}
                <div class="grid grid-cols-3 gap-3">
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Customer ID *</label><input type="text" name="customer_id" required class="gk-input-neon w-full"></div>
                    <div class="col-span-2"><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Company name *</label><input type="text" name="name" required class="gk-input-neon w-full"></div>
                </div>
                <div class="mt-3 grid grid-cols-3 gap-3">
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Street</label><input type="text" name="street" class="gk-input-neon w-full"></div>
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">City</label><input type="text" name="city" class="gk-input-neon w-full"></div>
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">ZIP</label><input type="text" name="zip" class="gk-input-neon w-full"></div>
                </div>
                <div class="mt-3 grid grid-cols-2 gap-3">
                    {% include "partials/forms/country_select.pongo2" with field_id="country_setup_task" field_name="country" select_classes="gk-select-neon w-full mt-1 block" %}
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">URL</label><input type="text" name="url" class="gk-input-neon w-full"></div>
                </div>
                <div class="mt-3"><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Comments</label><textarea name="comments" rows="2" class="gk-input-neon w-full"></textarea></div>
            {% elif Task.ID == "create_sla" %}
                <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">SLA name *</label><input type="text" name="name" required class="gk-input-neon w-full"></div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">First response (min)</label><input type="number" name="first_response_time" value="60" class="gk-input-neon w-full"></div>
                    <div><label class="block text-xs mb-1" style="color: var(--gk-text-muted);">Solution (min)</label><input type="number" name="solution_time" value="1440" class="gk-input-neon w-full"></div>
                </div>
            {% else %}
                <p class="text-sm" style="color: var(--gk-text-muted);">This task has no inline form. Use the relevant admin page directly.</p>
            {% endif %}
        {% endif %}

        <div class="flex justify-end pt-2">
            <button type="submit" id="taskSubmit" class="gk-btn-neon">{% if IsMarkComplete %}{{ t("setup.task.mark_complete_btn")|default:"Mark complete" }}{% else %}{{ t("setup.task.create_btn")|default:"Create" }}{% endif %}</button>
        </div>
    </form>
</div>

<style>
</style>

<script>
function submitTask(e) {
    e.preventDefault();
    const msg = document.getElementById('taskMsg'); msg.textContent = '';
    const btn = document.getElementById('taskSubmit'); btn.disabled = true;
    fetch('/admin/setup/task/setup-assistant/{{ Task.ID }}', { method:'POST', body: new FormData(document.getElementById('taskForm')) })
        .then(r => r.json())
        .then(res => {
            btn.disabled = false;
            if (res.success && res.redirect) { window.location.href = res.redirect; return; }
            msg.textContent = res.error || 'Failed.';
        })
        .catch(() => { btn.disabled = false; msg.textContent = 'Network error.'; });
}
</script>
{% endblock %}
