{% extends "layouts/auth.pongo2" %}

{% block title %}{% if Mode == "register" %}{{ t("self_service.register.complete_title")|default:"Choose your password" }}{% else %}{{ t("self_service.reset_password.title")|default:"Reset Password" }}{% endif %} - GoatFlow{% endblock %}

{% block content %}
<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
    <div class="absolute top-4 right-4 z-10 flex items-center gap-2">
        {% include "partials/language_selector.pongo2" %}
        {% include "partials/login_theme_selector.pongo2" %}
    </div>

    <div class="sm:mx-auto sm:w-full sm:max-w-sm relative z-10">
        <div class="gk-logo-glow gk-float mx-auto w-24 h-24" style="color: var(--gk-primary);">
            <img class="w-full h-full" src="/static/favicon.svg?v={{ assetVersion }}" alt="GoatFlow Logo">
        </div>
        <h2 class="mt-6 text-center text-3xl gk-heading gk-text-gradient">
            {% if Mode == "register" %}{{ t("self_service.register.complete_title")|default:"Choose your password" }}{% else %}{{ t("self_service.reset_password.title")|default:"Reset Password" }}{% endif %}
        </h2>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md relative z-10">
        <div class="gk-login-card">
            {% if Done %}
            <div id="selfservice-message" class="rounded-md p-4 mb-4 text-sm" role="status" style="background: var(--gk-success-subtle); color: var(--gk-success); border: 1px solid var(--gk-success);">
                {{ Message }}
            </div>
            <a href="{{ Portal.LoginURL }}" class="gk-btn-neon w-full block text-center">{{ t("auth.sign_in")|default:"Sign In" }}</a>
            {% elif Invalid %}
            <div id="selfservice-error" class="rounded-md p-4 mb-4 text-sm" role="alert" style="background: var(--gk-error-subtle); color: var(--gk-error); border: 1px solid var(--gk-error);">
                {{ Error }}
            </div>
            <a href="{{ RetryURL }}" class="gk-btn-neon w-full block text-center">
                {% if AccountExists %}{{ t("auth.forgot_password")|default:"Forgot password?" }}{% elif Mode == "register" %}{{ t("self_service.register.start_again")|default:"Register again" }}{% else %}{{ t("self_service.reset_password.request_new")|default:"Request a new link" }}{% endif %}
            </a>
            {% else %}
            {% if Error %}
            <div id="selfservice-error" class="rounded-md p-4 mb-4 text-sm" role="alert" style="background: var(--gk-error-subtle); color: var(--gk-error); border: 1px solid var(--gk-error);">
                {{ Error }}
            </div>
            {% endif %}

            <form class="space-y-5" action="{{ Action }}" method="POST">
                <input type="hidden" name="token" value="{{ Token }}">
                {% if Login %}
                <div>
                    <label for="login" class="form-label">{{ t("customer.auth.login")|default:"Login" }}</label>
                    <div class="mt-2">
                        <input id="login" type="text" autocomplete="username" readonly class="gk-input-neon" value="{{ Login }}">
                    </div>
                </div>
                {% endif %}
                <div>
                    <label for="password" class="form-label">{{ t("self_service.reset_password.new_password")|default:"New Password" }}</label>
                    <div class="mt-2">
                        <input id="password" name="password" type="password" autocomplete="new-password" required autofocus class="gk-input-neon">
                    </div>
                    {% if Requirements %}
                    <div class="mt-3 p-3 rounded-md" style="background: var(--gk-bg-tertiary);">
                        <p class="text-xs font-medium mb-2" style="color: var(--gk-text-muted);">{{ t("password.requirements")|default:"Password requirements:" }}</p>
                        <ul class="space-y-1 text-xs list-disc list-inside" style="color: var(--gk-text-muted);">
                            {% for req in Requirements %}
                            <li>{{ req }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    {% endif %}
                </div>
                <div>
                    <label for="confirm_password" class="form-label">{{ t("self_service.reset_password.confirm")|default:"Confirm Password" }}</label>
                    <div class="mt-2">
                        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required class="gk-input-neon">
                    </div>
                </div>
                <div class="pt-2">
                    <button type="submit" class="gk-btn-neon w-full">
                        {% if Mode == "register" %}{{ t("self_service.register.complete_submit")|default:"Create account" }}{% else %}{{ t("self_service.reset_password.submit")|default:"Reset Password" }}{% endif %}
                    </button>
                </div>
            </form>
            {% endif %}

            <p class="mt-6 text-center text-sm">
                <a href="{{ Portal.LoginURL }}" class="gk-link-neon">{{ t("auth.back_to_login")|default:"Back to Login" }}</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
