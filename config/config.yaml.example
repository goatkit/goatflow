# GoatFlow Local Configuration Override
# Copy this file to config.yaml for local development overrides
# These values override default.yaml
# DO NOT commit config.yaml to version control
# Typical local uses: adjust timezone, feature switches, local hosts.
#
# config.yaml is plain YAML: ${VAR} is not expanded.
# The database connection comes from environment variables only
# (DB_DRIVER, DB_MYSQL_* or DB_PGSQL_*), as do logging (LOG_*) and
# metrics (METRICS_*). See docs/configuration.md.

# Example overrides:
# app:
#   timezone: Europe/London
# features:
#   registration: true

app:
  debug: true
  env: development

valkey:
  host: localhost

auth:
  jwt:
    # Local-only secret; production should set JWT_SECRET or GOATFLOW_AUTH_JWT_SECRET.
    secret: "my-local-development-secret-key-change-in-production"

email:
  smtp:
    host: localhost
    port: 1025
  inbound:
    enabled: true
    poll_interval: 2m
    worker_count: 2
    max_accounts: 5
