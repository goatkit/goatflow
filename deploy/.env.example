# GoatFlow Configuration
# Copy to .env and customize all values marked CHANGE_ME

# =============================================================================
# Domain & TLS Configuration
# =============================================================================
# Your domain name (required for HTTPS)
DOMAIN=demo.goatflow.io

# Email for ACME/Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# =============================================================================
# Image Configuration
# =============================================================================
# Image tag for app, customer-fe and runner. No "v" prefix.
# Release: 0.10.0 (recommended), or 0.10 / 0 for the newest in that line.
# Branch builds: latest or main (main branch). "dev" exists for the app image
# only, not for goatflow-runner.
GOATFLOW_TAG=latest

# =============================================================================
# Database Configuration
# =============================================================================
DB_ROOT_PASSWORD=CHANGE_ME_use_strong_root_password
DB_USER=goatflow
DB_PASSWORD=CHANGE_ME_use_strong_password
DB_NAME=goatflow

# =============================================================================
# Security Configuration
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_use_random_string_minimum_32_characters

# Encryption key for stored secrets (plugin secure settings, webhook signing
# secrets). Required: exactly 64 hex characters, the same for app, customer-fe
# and runner. Generate with: openssl rand -hex 32
# Keep it stable: changing it makes existing secrets undecryptable.
GOATFLOW_SECURE_KEY=

# First-boot password for the admin account root@localhost. Applied once on
# the first start; change it in GoatFlow afterwards.
GOATFLOW_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=production
GIN_MODE=release
LOG_LEVEL=warn

# Public URL where GoatFlow is accessible (used for links in emails, etc.)
# Defaults to https://$DOMAIN
BASE_URL=https://demo.goatflow.io

# Public demo sites only: true stops non-admin users changing passwords and MFA
GOATFLOW_APP_DEMO_MODE=false

# =============================================================================
# Outgoing Email (SMTP)
# =============================================================================
# Used by the runner (mail queue: ticket notifications, password reset and
# sign-up links) and by the app. EMAIL_ENABLED=false keeps mail in the queue.
EMAIL_ENABLED=true
EMAIL_FROM=helpdesk@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = STARTTLS
SMTP_TLS=true
# plain or login
SMTP_AUTH_TYPE=plain
