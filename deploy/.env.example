# GoatFlow Configuration
# Copy to .env and customize all values marked CHANGE_ME

# =============================================================================
# Domain & TLS Configuration
# =============================================================================
# Your domain name (required for HTTPS)
DOMAIN=demo.goatflow.io

# Email for ACME/Let's Encrypt certificate registration
ACME_EMAIL=admin@example.com

# =============================================================================
# Image Configuration
# =============================================================================
# Image tag for app, customer-fe and runner. No "v" prefix.
# Release: 0.10.0 (recommended), or 0.10 / 0 for the newest in that line.
# Branch builds: latest or main (main branch). "dev" exists for the app image
# only, not for goatflow-runner.
GOATFLOW_TAG=latest

# =============================================================================
# Database Configuration
# =============================================================================
DB_ROOT_PASSWORD=CHANGE_ME_use_strong_root_password
DB_USER=goatflow
DB_PASSWORD=CHANGE_ME_use_strong_password
DB_NAME=goatflow

# =============================================================================
# Security Configuration
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_use_random_string_minimum_32_characters

# Encryption key for stored secrets (plugin secure settings, webhook signing
# secrets). 64 hex characters. Generate with: openssl rand -hex 32
# Keep it stable: changing it makes existing secrets undecryptable.
GOATFLOW_SECURE_KEY=

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=production
GIN_MODE=release
LOG_LEVEL=warn

# Public URL where GoatFlow is accessible (used for links in emails, etc.)
# Should match your DOMAIN with https://
BASE_URL=https://demo.goatflow.io
