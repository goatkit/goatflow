{
  "name": "@goatflow/sdk",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript SDK for the GoatFlow ticketing system API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "goatflow",
    "ticketing",
    "support",
    "api",
    "sdk",
    "typescript",
    "javascript"
  ],
  "author": "GoatFlow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goatkit/goatflow.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://goatflow.io",
  "bugs": {
    "url": "https://github.com/goatkit/goatflow/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
